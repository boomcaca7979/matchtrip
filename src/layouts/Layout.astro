---
interface Props {
  title?: string;
  description?: string;
  category?: string;
  canonical?: string;
  image?: string;
}

const {
  title = 'MatchTrip - Sports Travel Planner',
  description = 'Discover major sporting events worldwide and get complete travel plans with budget estimates. Follow the game, plan the journey.',
  category = 'default',
  canonical,
  image,
} = Astro.props;

const site = Astro.site ?? new URL('https://matchtrip-blue.vercel.app');
const canonicalURL = canonical ? new URL(canonical, site) : new URL(Astro.url.pathname, site);

// OG image per page category (files generated under /images/og/):
// football→football, motorsport→f1, tennis→tennis, golf→golf, everything else→default
const OG_IMAGE_BY_CATEGORY: Record<string, string> = {
  football: 'football',
  motorsport: 'formula1',
  tennis: 'tennis',
  golf: 'golf',
};
const categoryKey = String(category).trim().toLowerCase().replace(/[\s-]+/g, '-');
const ogImageFile = OG_IMAGE_BY_CATEGORY[categoryKey] || 'default';
// An explicit image prop (e.g. a content photo) overrides the category fallback
const ogImageURL = image ? new URL(image, site) : new URL(`/images/og/${ogImageFile}.png`, site);

// GA4 Measurement ID — 通过 Vercel 环境变量注入，不硬编码
const GA_MEASUREMENT_ID = import.meta.env.GA_MEASUREMENT_ID || '';

const siteOrigin = site.origin;
const jsonld = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "MatchTrip",
  "url": siteOrigin,
  "description": "Discover major sporting events worldwide and get complete travel plans with budget estimates.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": siteOrigin + "/events/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

// Organization entity: only verifiable fields — name, url, logo. No invented
// founder/employee/award data.
const organizationJsonld = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "MatchTrip",
  "url": siteOrigin,
  "logo": new URL('/favicon.svg', site).href,
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#111827" />
		<meta name="google-site-verification" content="hUhmeBzq4EIbPrlUciqwxguszGEqbTXAssk-PM5ep-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:site_name" content="MatchTrip" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonld, null, '\t')}>
		</script>
		<script type="application/ld+json" set:html={JSON.stringify(organizationJsonld, null, '\t')}>
		</script>

		<!-- Google AdSense -->
		<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4267926791604017"
			crossorigin="anonymous"></script>

		<!-- GA4 — 仅在配置了 GA_MEASUREMENT_ID 环境变量时加载 -->
		{GA_MEASUREMENT_ID && (
			<>
				<script
					is:inline
					async
					src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
				/>
				<script is:inline set:html={`
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', '${GA_MEASUREMENT_ID}');
				`} />
			</>
		)}

		<title>{title}</title>
	</head>
	<body>
		<slot />
		<script is:inline>
			// Affiliate click tracking — 预埋 dataLayer 事件，不依赖 GA4/GTM
			// 未来接入 analytics 时可直接消费 window.dataLayer
			window.dataLayer = window.dataLayer || [];
			document.addEventListener('click', function (e) {
				var el = e.target.closest && e.target.closest('[data-affiliate]');
				if (!el) return;
				window.dataLayer.push({
					event: 'affiliate_click',
					affiliate: el.dataset.affiliate,
					campaign: el.dataset.campaign,
					destination: el.dataset.destination,
					page: window.location.pathname
				});
			});
		</script>
	</body>
</html>

<style is:global>
	@import '../styles/global.css';
</style>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		scroll-behavior: smooth;
	}
</style>
