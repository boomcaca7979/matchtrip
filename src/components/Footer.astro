---
// Reusable site footer
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="logo">
        <span class="logo-icon" aria-hidden="true">⚡</span>
        <span class="logo-text">MatchTrip</span>
      </a>
      <p>Follow the Game. Plan the Journey.</p>
    </div>
    <div class="footer-links">
      <h4>Product</h4>
      <a href="/#features">Features</a>
      <a href="/events">Events</a>
    </div>
    <div class="footer-links">
      <h4>Company</h4>
      <a href="/#why">Why MatchTrip</a>
    </div>
    <div class="footer-links">
      <h4>Legal</h4>
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Service</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; 2026 MatchTrip. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid #e5e7eb;
    padding: 48px 0 24px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px 48px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #111;
    font-weight: 700;
    font-size: 1.25rem;
  }

  .logo-icon { font-size: 1.5rem; }

  .footer-brand p {
    color: #6b7280;
    margin-top: 12px;
    font-size: 0.9rem;
  }

  .footer-links h4 {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
    color: #111;
  }

  .footer-links a {
    display: block;
    color: #6b7280;
    text-decoration: none;
    margin-bottom: 10px;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: #111;
  }

  .footer-bottom {
    text-align: center;
    color: #9ca3af;
    font-size: 0.85rem;
    padding-top: 24px;
    border-top: 1px solid #f3f4f6;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
