---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const pageUrl = new URL('/editorial-policy/', Astro.site).href;

const policySchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "MatchTrip Editorial Policy",
  "description": "How MatchTrip researches, verifies, updates and corrects its sports travel guides — official sources, update frequency and correction policy.",
  "url": pageUrl,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL('/', Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Editorial Policy", item: pageUrl },
  ],
};

const schemaHtml = [policySchema, breadcrumbSchema]
  .map(schema => `<script type="application/ld+json">${JSON.stringify(schema, null, '\t')}</script>`)
  .join('\n');
---

<Layout
  title="Editorial Policy: Sources, Verification & Updates"
  description="How MatchTrip researches and verifies sports travel guides: official sources, update frequency, correction policy and affiliate disclosure — built for travelers who plan around events."
>
  <Navbar />

  <section class="policy-hero">
    <div class="container">
      <span class="tag">Editorial Policy</span>
      <h1>How MatchTrip Researches, Verifies and Updates Its Guides</h1>
      <p class="lead">
        Every event page on MatchTrip is built from official sources, checked on a published
        schedule, and corrected openly when we get something wrong. This page explains exactly
        how that works.
      </p>
    </div>
  </section>

  <section class="policy-body">
    <div class="container narrow">
      <h2 id="research-methodology">Research Methodology</h2>
      <p>Each event guide starts with the event's own organizing body — the federation, sanctioning body, or host venue — and is built outward from there. We record the event's dates, venue, ticketing structure and travel context only after they can be traced to an official channel. Where details matter to trip planning (ballot windows, on-sale phases, transit changes near stadiums), we note what the organizer has announced rather than what resale markets imply.</p>
      <p>Travel recommendations — where to stay, how to get to the stadium, what a weekend should cost — are written from the geography of each host city: real transit lines that reach the venue, real hotel zones at real distances, and price ranges observed across official ticket phases and published room rates around event dates. Budget tiers exist so travelers can scale a trip up or down, not to push any single booking option.</p>

      <h2 id="official-sources">Official Sources</h2>
      <p>We verify event facts against primary sources whenever they exist. That means the organizer's own website and ticketing platform first, and the host venue's official channels second. Aggregators, ticket resale marketplaces and news summaries are used only for cross-checking, never as the original record. When two official sources disagree, the organizing body of the event wins; when an announcement is pending, we say so rather than guess.</p>
      <ul class="source-list">
        <li><a href="https://www.fifa.com" target="_blank" rel="noopener noreferrer">FIFA</a> — World Cup calendars, ticketing phases and host venues</li>
        <li><a href="https://www.uefa.com" target="_blank" rel="noopener noreferrer">UEFA</a> — Champions League finals and ballot structure</li>
        <li><a href="https://www.formula1.com" target="_blank" rel="noopener noreferrer">Formula 1</a> — Grand Prix calendars and official ticket platforms</li>
        <li><a href="https://www.nfl.com" target="_blank" rel="noopener noreferrer">NFL</a> — Super Bowl host announcements and ticketing</li>
        <li><a href="https://www.wimbledon.com" target="_blank" rel="noopener noreferrer">Wimbledon</a> — The Championships' ballot and public queue</li>
        <li><a href="https://www.masters.com" target="_blank" rel="noopener noreferrer">The Masters</a> — practice round lotteries and badge policy</li>
        <li><a href="https://www.olympics.com" target="_blank" rel="noopener noreferrer">Olympics</a> and <a href="https://www.la28.org" target="_blank" rel="noopener noreferrer">LA28</a> — Games calendars and ticket phases</li>
      </ul>

      <h2 id="update-frequency">Update Frequency</h2>
      <p>Guides for upcoming events are reviewed continuously while their ticketing windows are open, and every page carries a visible "last updated" note so you can judge its freshness yourself:</p>
      <ul>
        <li><strong>Upcoming events</strong> — reviewed throughout the year, and immediately when an organizer announces a date, venue or ticketing change.</li>
        <li><strong>Ended events</strong> — archived and marked as previous editions. They stay online as planning references for the next edition, and their facts are frozen rather than silently rewritten.</li>
        <li><strong>City and venue guides</strong> — reviewed on a rolling basis: transit changes, new hotel zones and stadium renovations are folded in as they are confirmed by official channels.</li>
        <li><strong>Budget estimates</strong> — price ranges are refreshed against official ticket phases and host-city rates as each new event cycle opens.</li>
      </ul>

      <h2 id="correction-policy">Correction Policy</h2>
      <p>When an error is confirmed against an official source, we fix the page and, for material corrections — a wrong date, a moved venue, a misstated ticket process — note the change on the page itself. Minor refreshes (repriced hotel ranges, updated neighborhood notes) are batched into regular reviews without an individual notice.</p>
      <p>If you spot something out of date or wrong, <a href="/contact/">tell us</a>. Reports are checked against the official record, and corrections go live once verified — usually within a few days.</p>

      <h2 id="affiliate-disclosure">Affiliate Disclosure</h2>
      <p>MatchTrip is free to use. Some booking links (hotels, flights, experiences) are affiliate links that may earn us a commission at no extra cost to you. Affiliate relationships never determine which events we cover, how we rank them, or what we write — full details are in <a href="/about/#editorial-policy">our About page's editorial section</a>. We do not sell tickets and are not a ticket broker.</p>
    </div>
  </section>

  <Footer />
  <Fragment set:html={schemaHtml} />
</Layout>

<style>
  .policy-hero {
    padding: 120px 0 60px;
    text-align: center;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }

  .tag {
    display: inline-block;
    padding: 6px 16px;
    background: #f1f5f9;
    border-radius: 100px;
    font-size: 0.875rem;
    color: #475569;
    font-weight: 500;
    margin-bottom: 24px;
    border: 1px solid #e2e8f0;
  }

  .policy-hero h1 {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.5px;
    margin-bottom: 20px;
    color: #111;
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
  }

  .lead {
    font-size: 1.125rem;
    color: #6b7280;
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .policy-body {
    padding: 40px 0 80px;
  }

  .narrow {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px;
  }

  h2[id] {
    scroll-margin-top: 88px;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 48px 0 20px;
    color: #111;
  }

  .policy-body p {
    color: #4b5563;
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 18px;
  }

  .policy-body ul {
    margin: 0 0 18px 20px;
    padding: 0;
  }

  .policy-body li {
    color: #4b5563;
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 8px;
  }

  .source-list {
    list-style: none !important;
    margin: 24px 0 32px !important;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .source-list li {
    padding: 12px 16px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    font-size: 0.9375rem;
    color: #4b5563;
    line-height: 1.6;
    margin: 0;
  }

  .source-list a, .policy-body p a {
    color: #4f46e5;
    font-weight: 600;
    text-decoration: none;
  }

  .source-list a:hover, .policy-body p a:hover {
    text-decoration: underline;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  @media (max-width: 768px) {
    .policy-hero h1 { font-size: 1.75rem; }
    .source-list { grid-template-columns: 1fr; }
  }
</style>
