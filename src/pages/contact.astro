---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact - MatchTrip" description="Get in touch with MatchTrip. Questions, feedback, partnership inquiries — we'd love to hear from you.">
  <Navbar />

  <section class="contact-hero">
    <div class="container">
      <span class="tag">Contact Us</span>
      <h1>Get in<br/><span class="gradient">Touch.</span></h1>
      <p class="lead">Questions, feedback, or partnership ideas? We're here to help.</p>
    </div>
  </section>

  <section class="contact-methods">
    <div class="container">
      <div class="methods-grid">
        <div class="method-card">
          <div class="method-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <h3>Email Us</h3>
          <p>For general questions or feedback, send us an email.</p>
          <a href="mailto:hello@matchtrip.com" class="email-link">hello@matchtrip.com</a>
        </div>

        <div class="method-card">
          <div class="method-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Follow Us</h3>
          <p>Stay updated with the latest events and travel tips.</p>
          <div class="social-row">
            <a href="https://x.com/matchtrip" target="_blank" rel="noopener noreferrer" aria-label="Follow us on X">X (Twitter)</a>
            <a href="https://github.com/matchtrip" target="_blank" rel="noopener noreferrer" aria-label="View on GitHub">GitHub</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="info-sections">
    <div class="container narrow">
      <div class="info-block">
        <h2>Affiliate Partnerships</h2>
        <p>Interested in partnering with MatchTrip? We work with trusted travel, ticketing, and hospitality platforms to help sports fans plan their journeys. If you offer services that add value for traveling sports fans — from accommodation and flights to event tickets and local experiences — we'd love to explore a partnership.</p>
        <p>Reach out to <a href="mailto:hello@matchtrip.com">hello@matchtrip.com</a> with details about your offering and we'll get back to you.</p>
      </div>

      <div class="info-block">
        <h2>Feedback &amp; Suggestions</h2>
        <p>MatchTrip is built for sports fans like you. If you have ideas for new events, features you'd like to see, or anything that could make the experience better — we want to hear it.</p>
        <p>Drop us a line at <a href="mailto:hello@matchtrip.com">hello@matchtrip.com</a>. Every piece of feedback helps us improve.</p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .contact-hero {
    padding: 120px 0 60px;
    text-align: center;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }

  .tag {
    display: inline-block;
    padding: 6px 16px;
    background: #f1f5f9;
    border-radius: 100px;
    font-size: 0.875rem;
    color: #475569;
    font-weight: 500;
    margin-bottom: 24px;
    border: 1px solid #e2e8f0;
  }

  .contact-hero h1 {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -1px;
    margin-bottom: 20px;
    color: #111;
  }

  .gradient {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lead {
    font-size: 1.125rem;
    color: #6b7280;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .contact-methods {
    padding: 0 0 80px;
  }

  .methods-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .method-card {
    padding: 40px 36px;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    text-align: center;
  }

  .method-icon {
    width: 56px;
    height: 56px;
    background: #f1f5f9;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
  }

  .method-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: #111;
  }

  .method-card p {
    color: #6b7280;
    font-size: 0.9375rem;
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .email-link {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    color: #6366f1;
    text-decoration: none;
    padding: 8px 20px;
    border: 1px solid #6366f1;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .email-link:hover {
    background: #6366f1;
    color: white;
  }

  .social-row {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .social-row a {
    color: #6366f1;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 8px 16px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .social-row a:hover {
    border-color: #6366f1;
    background: #f1f5f9;
  }

  .info-sections {
    padding: 0 0 80px;
  }

  .narrow {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .info-block {
    margin-bottom: 48px;
  }

  .info-block:last-child {
    margin-bottom: 0;
  }

  .info-block h2 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 24px;
    color: #111;
  }

  .info-block p {
    color: #4b5563;
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 20px;
  }

  .info-block a {
    color: #6366f1;
    text-decoration: none;
    font-weight: 500;
  }

  .info-block a:hover {
    text-decoration: underline;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  @media (max-width: 768px) {
    .contact-hero h1 { font-size: 2.25rem; }
    .methods-grid { grid-template-columns: 1fr; }
    .info-sections { padding: 0 0 60px; }
    .contact-methods { padding: 0 0 60px; }
  }
</style>
