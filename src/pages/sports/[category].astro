---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import { eventsData } from '../../data/events';
import { buildHotelLink, buildActivityLink } from '../../utils/affiliate-links';

const slugify = (cat) => cat.toLowerCase().replace(/\s+/g, '-');

export function getStaticPaths() {
  const categories = [...new Set(Object.values(eventsData).map(e => e.category))];
  return categories.map(cat => ({
    params: { category: cat.toLowerCase().replace(/\s+/g, '-') },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const slug = Astro.params.category;

const entries = Object.entries(eventsData)
  .filter(([, e]) => e.category === category)
  .sort((a, b) => (b[1].year || 0) - (a[1].year || 0));

const categoryEvents = entries.map(([id, data]) => ({ id, ...data }));
const eventCount = categoryEvents.length;

const title = `${category} Sports Travel Guide | MatchTrip`;
const description = `Plan your ${category.toLowerCase()} sports trip with event schedules, hotels, flights, tickets and travel guides.`;
const seoDescription = description.length > 159 ? description.substring(0, 156) + '...' : description;

// Schema.org CollectionPage + ItemList
const pageUrl = new URL('/sports/' + slug, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${category} Sports Events`,
  description: seoDescription,
  url: pageUrl,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: categoryEvents.map((event, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL('/events/' + event.id, Astro.site).href,
      name: event.title,
    })),
  },
};
const schemaHtml = `<script type="application/ld+json">${JSON.stringify(schema, null, '\t')}</script>`;

// Count how many events have partnerRefs for CTA display
const hasActivityEvents = categoryEvents.some(e => e.partnerRefs?.activityQuery);
const hasHotelEvents = categoryEvents.some(e => e.partnerRefs?.hotelCity);

// Viator affiliate CTA: 用该分类下首个有 activityQuery 的 event 生成链接
const activityEvent = categoryEvents.find(e => e.partnerRefs?.activityQuery);
const activityUrl = activityEvent
  ? buildActivityLink({ query: activityEvent.partnerRefs.activityQuery, campaign: activityEvent.id })
  : '';
---

<Layout title={title} description={seoDescription}>
  <Navbar />

  <!-- Hero -->
  <section class="sport-hero">
    <div class="container">
      <a href="/events" class="back-link">&larr; All Events</a>
      <h1>{category}</h1>
      <p class="hero-count">{eventCount} event{eventCount !== 1 ? 's' : ''}</p>
      <p class="hero-sub">{seoDescription}</p>
    </div>
  </section>

  <!-- Events List -->
  <section class="sport-events">
    <div class="container">
      <h2>{category} Events</h2>
      <div class="events-grid">
        {categoryEvents.map(event => (
          <article class="event-card">
            <div class="event-image" style={`background: linear-gradient(135deg, ${event.colorFrom || '#6366f1'} 0%, ${event.colorTo || '#a855f7'} 100%)`}>
              <span class="event-emoji">{event.emoji || '🏟️'}</span>
              <span class="event-badge">{event.category}</span>
            </div>
            <div class="event-content">
              <div class="event-meta">
                <span class="event-date">{event.date}</span>
                <span class="event-location">{event.location?.label || event.location || ''}</span>
              </div>
              <a href={`/events/${event.id}/`} class="event-card-title-link"><h3>{event.title}</h3></a>
              <p>{event.description}</p>
              <div class="event-footer">
                <div class="event-price">
                  <span class="price-label">Est. Travel Cost</span>
                  <span class="price-value">{event.priceEstimate}</span>
                </div>
                <a href={`/events/${event.id}`} class="btn btn-primary">Plan Trip</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Travel CTA -->
  <section class="travel-cta-section">
    <div class="container">
      <h2>Travel Resources for {category} Events</h2>
      <div class="cta-grid">
        {hasActivityEvents && (
          <div class="cta-card">
            <span class="cta-icon">&#x1F3D6;&#xFE0F;</span>
            <h3>Things To Do</h3>
            <p>Explore tours, activities, and local experiences near your event venue. From stadium tours to city excursions.</p>
            <a href={activityUrl} class="btn btn-primary" data-affiliate="viator" data-campaign={activityEvent.id} data-destination="viator" target="_blank" rel="noopener noreferrer sponsored">Explore {category} Experiences</a>
          </div>
        )}
        {hasHotelEvents && (
          <div class="cta-card">
            <span class="cta-icon">&#x1F3E8;</span>
            <h3>Hotels & Accommodation</h3>
            <p>Find the best hotels near the event, from budget-friendly options to premium stays with event convenience.</p>
          </div>
        )}
        <div class="cta-card">
          <span class="cta-icon">&#x2708;&#xFE0F;</span>
          <h3>Travel Tips</h3>
          <p>Plan your sports travel with estimated budgets, venue guides, and transportation tips for each event.</p>
        </div>
      </div>
      <AffiliateDisclosure />
    </div>
  </section>

  <!-- Browse All Sports -->
  <section class="browse-section">
    <div class="container">
      <h2>Browse All Sports</h2>
      <div class="browse-grid">
        {[...new Set(Object.values(eventsData).map(e => e.category))].sort().map(cat => {
          const catSlug = slugify(cat);
          const count = Object.values(eventsData).filter(e => e.category === cat).length;
          return (
            <a href={`/sports/${catSlug}/`} class={`browse-link${cat === category ? ' active' : ''}`}>
              {cat}
              <span class="browse-count">{count}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <Fragment set:html={schemaHtml} />
  <Footer />
</Layout>

<style>
  .sport-hero {
    padding: 100px 0 60px;
    text-align: center;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }

  .back-link {
    display: inline-block;
    color: #6366f1;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 24px;
    transition: color 0.2s;
  }
  .back-link:hover { color: #4f46e5; }

  .sport-hero h1 {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -1px;
    margin-bottom: 8px;
    color: #111;
  }

  .hero-count {
    font-size: 0.95rem;
    color: #6366f1;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .hero-sub {
    font-size: 1.0625rem;
    color: #6b7280;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .sport-events {
    padding: 40px 0 60px;
  }

  .sport-events h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 24px;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 24px;
  }

  .event-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .event-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.1);
  }

  .event-image {
    position: relative;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .event-emoji {
    font-size: 3rem;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));
  }

  .event-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(255, 255, 255, 0.95);
    color: #111;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .event-content {
    padding: 24px;
  }

  .event-meta {
    display: flex;
    gap: 16px;
    margin-bottom: 10px;
    font-size: 0.85rem;
    color: #6b7280;
    flex-wrap: wrap;
  }

  .event-card-title-link {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: color 0.2s ease;
  }

  .event-card-title-link:hover { color: #6366f1; }

  .event-card-title-link h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: #111;
  }

  .event-content p {
    color: #4b5563;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .event-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid #f3f4f6;
  }

  .event-price {
    display: flex;
    flex-direction: column;
  }

  .price-label {
    font-size: 0.75rem;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .price-value {
    font-size: 1rem;
    font-weight: 700;
    color: #111;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background: #111;
    color: white;
    padding: 10px 20px;
    border-radius: 10px;
    border: none;
    font-size: 0.9rem;
  }

  .btn-primary:hover {
    background: #374151;
    transform: translateY(-1px);
  }

  .travel-cta-section {
    padding: 0 0 60px;
    background: #fafafa;
  }

  .travel-cta-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 24px;
    padding-top: 60px;
  }

  .cta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  .cta-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 28px;
    text-align: center;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .cta-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.06);
  }

  .cta-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 12px;
  }

  .cta-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 8px;
  }

  .cta-card p {
    color: #6b7280;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .browse-section {
    padding: 60px 0 80px;
  }

  .browse-section h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 20px;
  }

  .browse-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .browse-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 100px;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    color: #111;
    transition: all 0.2s ease;
  }

  .browse-link:hover {
    border-color: #6366f1;
    background: #f5f3ff;
    color: #6366f1;
  }

  .browse-link.active {
    background: #111827;
    border-color: #111827;
    color: white;
  }

  .browse-count {
    font-size: 0.75rem;
    color: #9ca3af;
    font-weight: 500;
  }

  .browse-link.active .browse-count {
    color: rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 768px) {
    .sport-hero h1 { font-size: 2rem; }
    .events-grid { grid-template-columns: 1fr; }
    .cta-grid { grid-template-columns: 1fr; }
  }
</style>
