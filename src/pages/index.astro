---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />

  <section class="hero">
    <div class="container">
      <p class="overline">Sports Travel Made Simple</p>
      <h1>Follow the Game.<br/><span class="gradient">Plan the Journey.</span></h1>
      <p class="subtitle">Discover major sporting events worldwide and get complete travel plans with budget estimates.</p>
      <div class="hero-buttons">
        <a href="/events" class="btn btn-primary">Explore Events</a>
        <a href="/#features" class="btn btn-secondary">How It Works</a>
      </div>
    </div>
  </section>

  <section class="features" id="features">
    <div class="container">
      <h2>Everything you need for sports travel</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon" aria-hidden="true">&#x1F4C5;</div>
          <h3>Event Calendar</h3>
          <p>Browse major sporting events worldwide with dates, locations, and ticket info.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon" aria-hidden="true">&#x2708;&#xFE0F;</div>
          <h3>Travel Budget</h3>
          <p>Get complete cost breakdowns including flights, hotels, and tickets.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon" aria-hidden="true">&#x1F5FA;&#xFE0F;</div>
          <h3>City Guides</h3>
          <p>Discover host cities with venue maps, transport tips, and local recommendations.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="events-preview" id="events">
    <div class="container">
      <h2>Featured Events</h2>
      <p class="section-subtitle">The biggest moments in sport, all in one place.</p>
      <div class="preview-grid">
        <a href="/events/world-cup-2026" class="preview-card">
          <div class="preview-image wc"></div>
          <div class="preview-body">
            <span class="preview-badge">Football</span>
            <h3>FIFA World Cup 2026</h3>
            <p>USA, Canada &amp; Mexico &middot; Jun &ndash; Jul 2026</p>
          </div>
        </a>
        <a href="/events/winter-olympics-2026" class="preview-card">
          <div class="preview-image olympics"></div>
          <div class="preview-body">
            <span class="preview-badge">Multi-Sport</span>
            <h3>Winter Olympics 2026</h3>
            <p>Milan-Cortina, Italy &middot; Feb 2026</p>
          </div>
        </a>
        <a href="/events/f1-monaco-2026" class="preview-card">
          <div class="preview-image f1"></div>
          <div class="preview-body">
            <span class="preview-badge">Motorsport</span>
            <h3>Formula 1 Monaco GP</h3>
            <p>Monaco &middot; May 2026</p>
          </div>
        </a>
      </div>
      <div class="preview-cta">
        <a href="/events" class="btn btn-primary">View All Events</a>
      </div>
    </div>
  </section>

  <section class="why" id="why">
    <div class="container">
      <h2>Why MatchTrip?</h2>
      <div class="why-grid">
        <div class="why-card">
          <div class="why-icon" aria-hidden="true">&#x2705;</div>
          <h3>All-in-One Planning</h3>
          <p>Flights, hotels, tickets, and city guides in a single view.</p>
        </div>
        <div class="why-card">
          <div class="why-icon" aria-hidden="true">&#x1F4B0;</div>
          <h3>Real-Time Budgets</h3>
          <p>Accurate cost estimates so you can plan with confidence.</p>
        </div>
        <div class="why-card">
          <div class="why-icon" aria-hidden="true">&#x1F512;</div>
          <h3>No Signup Required</h3>
          <p>Browse events and build travel plans without creating an account.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .hero {
    padding: 120px 0 80px;
    text-align: center;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }

  .overline {
    font-size: 0.875rem;
    font-weight: 600;
    color: #6366f1;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }

  .hero h1 {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 20px;
    color: #111;
  }

  .gradient {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: 1.125rem;
    color: #6b7280;
    max-width: 560px;
    margin: 0 auto 40px;
    line-height: 1.6;
  }

  .hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
  }

  .features {
    padding: 80px 0;
    background: #f9fafb;
  }

  .features h2 {
    font-size: 1.75rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 48px;
    color: #111;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .feature-card {
    background: white;
    border-radius: 16px;
    padding: 32px;
    text-align: center;
    border: 1px solid #e5e7eb;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.08);
  }

  .feature-icon {
    font-size: 2rem;
    margin-bottom: 16px;
  }

  .feature-card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 8px;
    color: #111;
  }

  .feature-card p {
    color: #6b7280;
    font-size: 0.95rem;
  }

  .events-preview {
    padding: 80px 0;
  }

  .events-preview h2 {
    font-size: 1.75rem;
    font-weight: 700;
    text-align: center;
    color: #111;
    margin-bottom: 8px;
  }

  .section-subtitle {
    text-align: center;
    color: #6b7280;
    margin-bottom: 48px;
  }

  .preview-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .preview-card {
    text-decoration: none;
    color: inherit;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #e5e7eb;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .preview-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.1);
  }

  .preview-image {
    height: 160px;
  }

  .preview-image.wc {
    background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 100%);
  }

  .preview-image.olympics {
    background: linear-gradient(135deg, #1e1b4b 0%, #6366f1 100%);
  }

  .preview-image.f1 {
    background: linear-gradient(135deg, #7f1d1d 0%, #dc2626 100%);
  }

  .preview-body {
    padding: 20px;
  }

  .preview-badge {
    display: inline-block;
    background: #f3f4f6;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #4b5563;
    margin-bottom: 8px;
  }

  .preview-body h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 4px;
  }

  .preview-body p {
    color: #6b7280;
    font-size: 0.9rem;
  }

  .preview-cta {
    text-align: center;
    margin-top: 40px;
  }

  .why {
    padding: 80px 0;
    background: #f9fafb;
  }

  .why h2 {
    font-size: 1.75rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 48px;
    color: #111;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .why-card {
    text-align: center;
    padding: 32px;
  }

  .why-icon {
    font-size: 2rem;
    margin-bottom: 16px;
  }

  .why-card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 8px;
    color: #111;
  }

  .why-card p {
    color: #6b7280;
    font-size: 0.95rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background: #111;
    color: white;
    padding: 12px 24px;
    border-radius: 10px;
    border: none;
  }

  .btn-primary:hover {
    background: #374151;
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: transparent;
    color: #111;
    padding: 12px 24px;
    border-radius: 10px;
    border: 1px solid #e5e7eb;
  }

  .btn-secondary:hover {
    background: #f9fafb;
  }

  @media (max-width: 768px) {
    .hero h1 { font-size: 2.25rem; }
    .hero-buttons { flex-direction: column; align-items: center; }
    .features-grid,
    .preview-grid,
    .why-grid { grid-template-columns: 1fr; }
  }
</style>
