---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { eventsData } from '../data/events';

const allEvents = Object.entries(eventsData).map(([id, data]) => ({
  id,
  title: data.title,
  category: data.category,
  location: data.location?.label || data.location,
  date: data.date,
  colorFrom: data.colorFrom,
  colorTo: data.colorTo,
  emoji: data.emoji,
}));

const featuredEvents = allEvents.slice(0, 3);

const stats = [
  { number: `${allEvents.length}+`, label: 'Major Events' },
  { number: '15+', label: 'Host Cities' },
  { number: '100%', label: 'Free to Use' },
];
---

<Layout>
  <Navbar />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container">
      <span class="hero-badge">Sports Travel Made Simple</span>
      <h1 class="hero-title">
        Follow the Game.<br/>
        <span class="gradient-text">Plan the Journey.</span>
      </h1>
      <p class="hero-subtitle">
        Discover major sporting events worldwide and get complete travel plans with budget estimates — flights, hotels, tickets, and city guides, all in one place.
      </p>
      <div class="hero-actions">
        <a href="/events/" class="btn btn-primary btn-lg">Explore Events</a>
        <a href="/about/" class="btn btn-secondary btn-lg">How It Works</a>
      </div>
      <div class="hero-stats">
        {stats.map(stat => (
          <>
            <div class="stat">
              <span class="stat-value">{stat.number}</span>
              <span class="stat-label">{stat.label}</span>
            </div>
            <div class="stat-divider" aria-hidden="true"></div>
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="features" id="features">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">What You Get</span>
        <h2 class="section-title">Everything for sports travel</h2>
        <p class="section-subtitle">Plan your trip from kickoff to touchdown with tools designed for the traveling fan.</p>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <h3>Event Calendar</h3>
          <p>Browse major sporting events worldwide with dates, locations, and ticket info — from the World Cup to the Grand Slam finals.</p>
          <a href="/events/" class="feature-link">Browse events &rarr;</a>
        </div>
        <div class="feature-card featured">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3>Travel Budget</h3>
          <p>Get complete cost breakdowns including flights, hotels, and tickets so you know exactly what to expect before you book.</p>
          <a href="/events/" class="feature-link">See estimates &rarr;</a>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3>City Guides</h3>
          <p>Discover host cities with venue maps, transport tips, and local recommendations to make the most of your trip.</p>
          <a href="/events/" class="feature-link">Explore guides &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Events -->
  <section class="events" id="events">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">2026 Calendar</span>
        <h2 class="section-title">Featured Events</h2>
        <p class="section-subtitle">The biggest moments in sport, all in one place.</p>
      </div>

      <div class="events-grid">
        {featuredEvents.map(event => (
          <a href={`/events/${event.id}/`} class="event-card">
            <div class="event-visual" style={`background: linear-gradient(135deg, ${event.colorFrom} 0%, ${event.colorTo} 100%)`}>
              <span class="event-visual-emoji">{event.emoji}</span>
            </div>
            <div class="event-info">
              <span class="event-badge">{event.category}</span>
              <h3>{event.title}</h3>
              <p class="event-meta">{event.location} &middot; {event.date}</p>
              <span class="event-link">Plan Trip &rarr;</span>
            </div>
          </a>
        ))}
      </div>

      <div class="events-cta">
        <a href="/events/" class="btn btn-primary btn-lg">View All Events</a>
      </div>
    </div>
  </section>

  <!-- All Events Links (for SEO crawlability) -->
  <section class="all-events" id="all-events">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">All Events</span>
        <h2 class="section-title">Every Event We Cover</h2>
        <p class="section-subtitle">Browse all major sporting events with travel guides and budget estimates.</p>
      </div>
      <div class="all-events-links">
        {allEvents.map(event => (
          <a href={`/events/${event.id}/`} class="all-event-link">
            <span class="all-event-emoji">{event.emoji}</span>
            <span class="all-event-title">{event.title}</span>
            <span class="all-event-meta">{event.location} &middot; {event.date}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works / Why -->
  <section class="why" id="why">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Why MatchTrip</span>
        <h2 class="section-title">Built for traveling fans</h2>
        <p class="section-subtitle">No accounts, no noise — just the information you need to get from the sofa to the stadium.</p>
      </div>
      <div class="why-grid">
        <div class="why-card">
          <div class="why-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h3>All-in-One Planning</h3>
          <p>Flights, hotels, tickets, and city guides in a single view. No tab-hopping across a dozen sites.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h3>Real-Time Budgets</h3>
          <p>Accurate cost estimates so you can plan with confidence — no signup required to see pricing.</p>
        </div>
        <div class="why-card">
          <div class="why-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h3>No Signup Required</h3>
          <p>Browse events and build travel plans without creating an account. No spam, no tracking — just sports travel.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter / Stay Updated -->
  <section class="newsletter" id="newsletter">
    <div class="container">
      <div class="newsletter-card">
        <div class="newsletter-content">
          <h2>Stay Updated</h2>
          <p>New events added weekly. Get notified when we add more destinations and travel guides.</p>
        </div>
        <a href="/contact/" class="btn btn-primary newsletter-btn">Get in Touch</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Hero */
  .hero {
    padding: 120px 0 80px;
    text-align: center;
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 50% 0%, rgba(99, 102, 241, 0.06) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero .container {
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-block;
    padding: 6px 16px;
    background: #f1f5f9;
    border-radius: 100px;
    font-size: 0.875rem;
    color: #475569;
    margin-bottom: 24px;
    font-weight: 500;
    border: 1px solid #e2e8f0;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -1px;
    margin-bottom: 24px;
    line-height: 1.1;
    color: #111;
  }

  .gradient-text {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: #6b7280;
    max-width: 560px;
    margin: 0 auto 40px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-bottom: 64px;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 48px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 800;
    color: #111;
  }

  .stat-label {
    font-size: 0.875rem;
    color: #6b7280;
  }

  .stat-divider {
    width: 1px;
    height: 48px;
    background: #e2e8f0;
  }

  .stat-divider:last-child { display: none; }

  /* Section Styles */
  .features, .events, .why {
    padding: 100px 0;
  }

  .events {
    background: #f8fafc;
  }

  .section-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .section-tag {
    display: inline-block;
    padding: 6px 14px;
    background: #f1f5f9;
    border-radius: 100px;
    font-size: 0.813rem;
    color: #475569;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
    border: 1px solid #e2e8f0;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.5px;
    margin-bottom: 16px;
    color: #111;
  }

  .section-subtitle {
    font-size: 1.0625rem;
    color: #6b7280;
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Container */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Features */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .feature-card {
    padding: 36px;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    transition: all 0.3s ease;
  }

  .feature-card:hover {
    border-color: #cbd5e1;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
    transform: translateY(-4px);
  }

  .feature-card.featured {
    background: #111827;
    border-color: #111827;
    color: white;
  }

  .feature-card.featured .feature-icon {
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  .feature-card.featured .feature-link {
    color: #a5b4fc;
  }

  .feature-card.featured p {
    color: #9ca3af;
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f1f5f9;
    border-radius: 12px;
    margin-bottom: 20px;
    color: #111;
  }

  .feature-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .feature-card p {
    font-size: 0.9375rem;
    color: #6b7280;
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .feature-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: #111;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .feature-link:hover {
    color: #6366f1;
  }

  /* Events Grid (Homepage) */
  .events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .event-card {
    text-decoration: none;
    color: inherit;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    background: white;
    transition: all 0.3s ease;
  }

  .event-card:hover {
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
    transform: translateY(-4px);
  }

  .event-visual {
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .event-visual-emoji {
    font-size: 3.5rem;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.25));
  }

  .event-info {
    padding: 20px;
  }

  .event-badge {
    display: inline-block;
    background: #f1f5f9;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #475569;
    margin-bottom: 8px;
  }

  .event-info h3 {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 4px;
    color: #111;
  }

  .event-meta {
    color: #6b7280;
    font-size: 0.875rem;
    margin-bottom: 12px;
  }

  .event-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: #6366f1;
  }

  .events-cta {
    text-align: center;
    margin-top: 48px;
  }

  /* All Events Links */
  .all-events {
    padding: 80px 0;
    background: #f8fafc;
  }

  .all-events-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .all-event-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
  }

  .all-event-link:hover {
    border-color: #6366f1;
    background: #f5f3ff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.08);
  }

  .all-event-emoji {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .all-event-title {
    font-weight: 600;
    font-size: 0.95rem;
    color: #111;
  }

  .all-event-meta {
    font-size: 0.8rem;
    color: #6b7280;
    margin-left: auto;
    white-space: nowrap;
  }

  /* Why Section */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .why-card {
    text-align: center;
    padding: 40px 32px;
  }

  .why-icon {
    margin-bottom: 24px;
  }

  .why-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 16px;
    color: #111;
  }

  .why-card p {
    font-size: 0.9375rem;
    color: #6b7280;
    line-height: 1.7;
  }

  /* Newsletter */
  .newsletter {
    padding: 80px 24px;
    background: #f8fafc;
  }

  .newsletter-card {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 48px 40px;
  }

  .newsletter-content h2 {
    font-size: 1.75rem;
    font-weight: 800;
    margin-bottom: 8px;
    color: #111;
  }

  .newsletter-content p {
    color: #6b7280;
    margin-bottom: 32px;
  }

  .newsletter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    font-weight: 600;
    font-size: 1rem;
    border-radius: 10px;
    text-decoration: none;
    background: #111;
    color: white;
    transition: all 0.2s ease;
  }

  .newsletter-btn:hover {
    background: #374151;
    transform: translateY(-1px);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-weight: 600;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    border: none;
    font-size: 0.875rem;
    padding: 10px 20px;
  }

  .btn-lg {
    padding: 14px 28px;
    font-size: 1rem;
  }

  .btn-primary {
    background: #111;
    color: white;
  }

  .btn-primary:hover {
    background: #374151;
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: white;
    color: #111;
    border: 1px solid #e2e8f0;
  }

  .btn-secondary:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
  }

  @media (max-width: 1024px) {
    .features-grid,
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .events-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero-title { font-size: 2.25rem; }
    .hero-actions { flex-direction: column; align-items: center; }
    .hero-stats { flex-direction: column; gap: 24px; }
    .stat-divider { width: 48px; height: 1px; }
    .section-title { font-size: 1.75rem; }
    .features-grid,
    .events-grid,
    .why-grid { grid-template-columns: 1fr; }
    .all-events-links { grid-template-columns: 1fr; }
    .all-event-meta { display: none; }
    .events-grid { gap: 16px; }
    .feature-card { padding: 28px; }
    .newsletter-card { padding: 32px 24px; }
  }

  @media (max-width: 480px) {
    .hero-title { font-size: 1.75rem; }
    .btn-lg { width: 100%; }
  }
</style>
