---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { eventsData } from '../../data/events';

const guides = Object.entries(eventsData)
  .filter(([, data]) => data.travelGuide)
  .map(([id, data]) => ({
    id,
    title: data.title,
    category: data.category,
    location: data.location?.label || data.location,
    date: data.date,
    description: data.description,
    priceEstimate: data.priceEstimate,
    colorFrom: data.colorFrom,
    colorTo: data.colorTo,
    emoji: data.emoji,
    hasAccommodation: !!data.travelGuide.accommodationAreas?.length,
    hasTransportation: !!data.travelGuide.transportationTips?.length,
    hasTickets: !!data.travelGuide.ticketTips?.length,
  }));

const categories = [...new Set(guides.map(g => g.category))];
---

<Layout
  title="Travel Guides – MatchTrip"
  description="Expert travel guides for major sporting events worldwide. Plan your trip with accommodation tips, transportation advice, and ticket information."
>
  <Navbar />

  <section class="guides-hero">
    <div class="container">
      <h1>Travel Guides</h1>
      <p class="subtitle">
        Help sports travelers plan their event trips — including accommodation,
        transportation, tickets, and local experiences.
      </p>
    </div>
  </section>

  <section class="guides-section">
    <div class="container">
      <div class="guides-header">
        <h2>All Guides</h2>
        <p class="guides-count">{guides.length} guides</p>
      </div>

      <div class="guides-grid">
        {guides.map(guide => (
          <article class="guide-card">
            <div class="guide-image" style={`background: linear-gradient(135deg, ${guide.colorFrom} 0%, ${guide.colorTo} 100%)`}>
              <span class="guide-emoji">{guide.emoji}</span>
              <span class="guide-badge">{guide.category}</span>
            </div>
            <div class="guide-content">
              <div class="guide-meta">
                <span class="guide-date">{guide.date}</span>
                <span class="guide-location">{guide.location}</span>
              </div>
              <a href={`/events/${guide.id}/`} class="guide-card-title-link"><h3>{guide.title}</h3></a>
              <p>{guide.description}</p>
              {guide.hasAccommodation || guide.hasTransportation || guide.hasTickets ? (
                <div class="guide-tags">
                  {guide.hasAccommodation && <span class="guide-tag accommodation">Accommodation</span>}
                  {guide.hasTransportation && <span class="guide-tag transportation">Transportation</span>}
                  {guide.hasTickets && <span class="guide-tag tickets">Tickets</span>}
                </div>
              ) : null}
              <div class="guide-footer">
                <div class="guide-price">
                  <span class="price-label">Est. Travel Cost</span>
                  <span class="price-value">{guide.priceEstimate}</span>
                </div>
                <a href={`/events/${guide.id}/`} class="btn btn-primary">Read Guide</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .guides-hero {
    padding: 100px 0 48px;
    text-align: center;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }

  .guides-hero h1 {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -1px;
    margin-bottom: 20px;
    color: #111;
  }

  .subtitle {
    font-size: 1.0625rem;
    color: #6b7280;
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .guides-section {
    padding: 48px 0 80px;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .guides-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .guides-header h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #111;
  }

  .guides-count {
    color: #6b7280;
    font-size: 0.95rem;
  }

  .guides-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .guide-card {
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    overflow: hidden;
    background: white;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .guide-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.08);
  }

  .guide-image {
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .guide-emoji {
    font-size: 3rem;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.15));
  }

  .guide-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(4px);
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 600;
    color: white;
  }

  .guide-content {
    padding: 24px;
  }

  .guide-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
  }

  .guide-date,
  .guide-location {
    font-size: 0.825rem;
    color: #6b7280;
  }

  .guide-card-title-link {
    text-decoration: none;
  }

  .guide-card-title-link h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 8px;
    line-height: 1.4;
  }

  .guide-card-title-link:hover h3 {
    color: #6366f1;
  }

  .guide-content p {
    color: #6b7280;
    font-size: 0.875rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 16px;
  }

  .guide-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .guide-tag {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .guide-tag.accommodation {
    background: #dbeafe;
    color: #1e40af;
  }

  .guide-tag.transportation {
    background: #dcfce7;
    color: #166534;
  }

  .guide-tag.tickets {
    background: #fef3c7;
    color: #92400e;
  }

  .guide-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid #f3f4f6;
  }

  .guide-price {
    display: flex;
    flex-direction: column;
  }

  .price-label {
    font-size: 0.75rem;
    color: #9ca3af;
    font-weight: 500;
  }

  .price-value {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #111;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-weight: 600;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    border: none;
    padding: 10px 20px;
    font-size: 0.875rem;
  }

  .btn-primary {
    background: #111;
    color: white;
  }

  .btn-primary:hover {
    background: #374151;
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .guides-hero h1 { font-size: 2.25rem; }
    .guides-grid { grid-template-columns: 1fr; }
    .guide-image { height: 140px; }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .guides-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
