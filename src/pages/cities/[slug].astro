---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { eventsData } from '../../data/events';
import { venuesData } from '../../data/venues';
import { citiesContent } from '../../data/cities';
import { buildHotelLink, buildActivityLink } from '../../utils/affiliate-links';

export function getStaticPaths() {
  const cityMap = new Map();

  Object.entries(eventsData).forEach(([id, event]) => {
    const city = event.location?.city;
    if (!city) return;

    const slug = city.toLowerCase().replace(/\s+/g, '-');

    if (!cityMap.has(slug)) {
      cityMap.set(slug, {
        slug,
        city,
        country: event.location.country,
        continent: event.location.continent,
        events: [],
      });
    }

    cityMap.get(slug).events.push({ id, ...event });
  });

  return Array.from(cityMap.values()).map(entry => ({
    params: { slug: entry.slug },
    props: entry,
  }));
}

const { city, country, continent, events } = Astro.props;

const slug = city.toLowerCase().replace(/\s+/g, '-');
const pageUrl = new URL(`/cities/${slug}/`, Astro.site).href;

// Editorial city guide content (falls back to the generic layout when absent)
const content = citiesContent[slug];

// Hero image — only rendered when a photo exists in /images/content/ (no placeholder otherwise)
const cityImages = ['london', 'new-york', 'los-angeles', 'las-vegas', 'singapore', 'madrid', 'paris', 'melbourne', 'budapest', 'monte-carlo'];
const hasCityImage = cityImages.includes(slug);

const upcomingEvents = events.filter(e => e.status !== 'ended');
const pastEvents = events.filter(e => e.status === 'ended');
const eventCount = events.length;
const upcomingCount = upcomingEvents.length;

// First event with an activityQuery for the Things To Do CTA
const activityEvent = events.find(e => e.partnerRefs?.activityQuery);
const activityUrl = activityEvent
  ? buildActivityLink({ query: activityEvent.partnerRefs.activityQuery, campaign: `city-${slug}` })
  : null;

// Hotel CTA: use the first event's checkin/checkout for context (or none for city page)
const hotelUrl = buildHotelLink({ city, campaign: `city-${slug}` });

// Related cities: same continent, exclude self
const allCities = new Map();
Object.entries(eventsData).forEach(([, event]) => {
  const c = event.location?.city;
  if (!c) return;
  const s = c.toLowerCase().replace(/\s+/g, '-');
  if (!allCities.has(s)) {
    allCities.set(s, {
      slug: s,
      city: c,
      country: event.location.country,
      continent: event.location.continent,
    });
  }
});
const relatedCities = Array.from(allCities.values())
  .filter(c => c.slug !== slug && c.continent === continent)
  .slice(0, 4);

// Plan-section event cards: this city's upcoming events (fall back to past
// events when nothing is upcoming), capped at 3 — real events only.
const planEventCards = (upcomingEvents.length > 0 ? upcomingEvents : events).slice(0, 3);

// A city with a single event links only two event URLs (hub + event); top up
// with upcoming events elsewhere (same continent first) so every city page
// links at least three event pages.
const ownEventIds = new Set(events.map(e => e.id));
const moreEvents = events.length < 2
  ? Object.entries(eventsData)
      .filter(([id, e]) => !ownEventIds.has(id) && e.status !== 'ended')
      .map(([id, e]) => ({ id, ...e }))
      .sort((a, b) =>
        (a.location?.continent === continent ? 0 : 1) -
        (b.location?.continent === continent ? 0 : 1)
      )
      .slice(0, 2)
  : [];

// Venue guide cards: venues in this city first, then same continent, then the
// rest of the catalogue — every city page links at least two venue pages.
const venueRank = v => {
  if (v.citySlug === slug) return 0;
  if (v.continent === continent) return 1;
  return 2;
};
const planVenueCards = Object.values(venuesData)
  .sort((a, b) => venueRank(a) - venueRank(b))
  .slice(0, 3);

// Venue guide links for the More on MatchTrip section (only cities with editorial content)
const linkedVenues = (content?.majorVenues || []).filter(v => v && v.venueSlug);

// Per-city SEO title/description from citiesContent, falling back to the
// generic template when a city has no editorial entry
const pageTitle = content?.seoTitle || `${city} Sports Travel Guide | MatchTrip`;
const pageDescription = content?.metaDescription || `Plan your ${city} sports trip with event guides, hotels, flights, tickets and things to do.`;

// Schema
const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": pageUrl,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": events.map((event, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": new URL(`/events/${event.id}/`, Astro.site).href,
      "name": event.title,
    })),
  },
};

// City structured data with real-world coordinates from citiesContent
// (cities without an editorial entry have no coordinates and skip this schema)
const citySchema = content?.coordinates
  ? {
      "@context": "https://schema.org",
      "@type": "City",
      "name": city,
      "url": pageUrl,
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": content.coordinates.lat,
        "longitude": content.coordinates.lng,
      },
    }
  : null;

// Breadcrumb structured data: Home > Cities > City
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL('/', Astro.site).href },
    { "@type": "ListItem", "position": 2, "name": "Cities", "item": new URL('/cities/', Astro.site).href },
    { "@type": "ListItem", "position": 3, "name": city, "item": pageUrl },
  ],
};

// ImageObject structured data: only when a hero city photo exists in /images/content/
const imageSchema = hasCityImage ? {
  "@context": "https://schema.org",
  "@type": "ImageObject",
  "url": `https://matchtrip-blue.vercel.app/images/content/${slug}.jpg`,
  "contentUrl": `https://matchtrip-blue.vercel.app/images/content/${slug}.jpg`,
  "name": `${city} travel guide image`,
  "caption": `${city} sports travel guide — stadiums, events and where to stay in ${city}`,
  "license": "https://matchtrip-blue.vercel.app/terms/",
} : null;

const schemaHtml = [collectionPageSchema, citySchema, imageSchema, breadcrumbSchema]
  .filter(Boolean)
  .map(schema => `<script type="application/ld+json">${JSON.stringify(schema, null, '\t')}</script>`)
  .join('\n');
---

<Layout title={pageTitle} description={pageDescription} image={hasCityImage ? `/images/content/${slug}.jpg` : undefined}>
  <Navbar />

  <!-- Hero -->
  <section class="city-hero">
    <div class="container">
      <a href="/events/" class="back-link">&larr; All Events</a>
      <h1>{city} Sports Travel Guide</h1>
      <p class="city-country">{country}</p>
      <p class="city-count">{upcomingCount > 0 ? `${upcomingCount} upcoming event${upcomingCount !== 1 ? 's' : ''}` : `${eventCount} event${eventCount !== 1 ? 's' : ''}`}</p>
      <p class="city-subtitle">Plan your trip to {city} for the biggest sporting events. Find hotels, tickets, and things to do.</p>
      {hasCityImage && (
        <div class="city-hero-img">
          <img src={"/images/content/" + slug + ".jpg"} alt={`${city} sports travel guide — stadiums, events and where to stay in ${city}`} loading="lazy" width="1200" height="630" />
        </div>
      )}
    </div>
  </section>

  <!-- City Introduction -->
  <section class="city-intro">
    <div class="container narrow">
      {content ? (
        <p>{content.intro}</p>
      ) : (
        <p>{city} is a premier sports destination in {country}, hosting world-class events that attract fans from across {continent === 'North America' ? 'the globe' : continent === 'Europe' ? 'Europe and beyond' : continent === 'Asia' ? 'Asia and beyond' : 'around the world'}. Whether you're here for a championship match, a Grand Prix, or a historic tournament, our guides help you find the best hotels, plan your transportation, and discover local experiences that make your trip unforgettable.</p>
      )}
    </div>
  </section>

  {content && (
    <>
      <!-- Sports Culture -->
      <section class="guide-section">
        <div class="container narrow">
          <h2>Sports Culture</h2>
          <p class="guide-text">{content.sportsCulture}</p>
        </div>
      </section>

      <!-- Major Venues -->
      <section class="guide-section">
        <div class="container">
          <h2>Major Venues</h2>
          <ul class="venue-list">
            {content.majorVenues.map(v => (
              <li>
                {v.venueSlug ? (
                  <a href={`/venues/${v.venueSlug}/`}>{v.name}</a>
                ) : (
                  <span>{v.name}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Airports & Arrival -->
      {content.airports?.length > 0 && (
        <section class="guide-section">
          <div class="container">
            <h2>Airports &amp; Arrival</h2>
            <div class="guide-grid">
              {content.airports.map(airport => (
                <div class="guide-card">
                  <div class="airport-head">
                    <span class="airport-code">{airport.code}</span>
                    <h3 class="guide-card-title airport-name">{airport.name}</h3>
                  </div>
                  <p>{airport.detail}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- Getting Around -->
      <section class="guide-section">
        <div class="container">
          <h2>Getting Around {city}</h2>
          <div class="guide-grid">
            {content.transportation.map(item => (
              <div class="guide-card">
                <span class="transport-mode">{item.mode}</span>
                <p>{item.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Where to Stay -->
      <section class="guide-section">
        <div class="container">
          <h2>Where to Stay in {city}</h2>
          <div class="guide-grid">
            {content.accommodationZones.map(zone => (
              <div class="guide-card">
                <h3 class="guide-card-title">{zone.name}</h3>
                <p>{zone.description}</p>
                <a href={buildHotelLink({ city: zone.searchQuery, campaign: `city-${slug}` })} class="btn btn-outline guide-card-link" target="_blank" rel="noopener noreferrer sponsored">Search Hotels</a>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Travel Tips -->
      <section class="guide-section">
        <div class="container narrow">
          <h2>Travel Tips</h2>
          <ul class="tips-list">
            {content.travelTips.map(tip => <li>{tip}</li>)}
          </ul>
        </div>
      </section>
    </>
  )}

  <!-- Things To Do -->
  {activityUrl && (
    <section class="city-activities-section">
      <div class="container">
        <div class="city-activities-card">
          <h2>Things To Do in {city}</h2>
          <p>Explore tours, attractions, and experiences for travelers visiting {city}.</p>
          <a href={activityUrl} class="btn btn-green" data-affiliate="viator" data-campaign={`city-${slug}`} data-destination="viator" target="_blank" rel="noopener noreferrer sponsored">Explore {city} Experiences</a>
        </div>
      </div>
    </section>
  )}

  <!-- Events -->
  <section class="events-section">
    <div class="container">
      {content && <p class="calendar-note">{content.eventCalendarNote}</p>}

      {upcomingEvents.length > 0 && (
        <>
          <h2>Upcoming Events in {city}</h2>
          <div class="events-grid">
            {upcomingEvents.map(event => (
              <article class="event-card">
                <div class="event-image" style={`background: linear-gradient(135deg, ${event.colorFrom || '#6366f1'} 0%, ${event.colorTo || '#a855f7'} 100%)`}>
                  <span class="event-emoji">{event.emoji || '🏟️'}</span>
                  <span class="event-badge">{event.category}</span>
                </div>
                <div class="event-content">
                  <div class="event-meta">
                    <span class="event-date">{event.date}</span>
                  </div>
                  <a href={`/events/${event.id}/`} class="event-card-title-link"><h3>{event.title}</h3></a>
                  <p>{event.description}</p>
                  <div class="event-footer">
                    <div class="event-price">
                      <span class="price-label">Est. Travel Cost</span>
                      <span class="price-value">{event.priceEstimate}</span>
                    </div>
                    <a href={`/events/${event.id}/`} class="btn btn-primary">Plan Trip</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </>
      )}

      {pastEvents.length > 0 && (
        <>
          <h2 class="past-heading">Past Events in {city}</h2>
          <div class="events-grid">
            {pastEvents.map(event => (
              <article class="event-card">
                <div class="event-image" style={`background: linear-gradient(135deg, ${event.colorFrom || '#6366f1'} 0%, ${event.colorTo || '#a855f7'} 100%)`}>
                  <span class="event-emoji">{event.emoji || '🏟️'}</span>
                  <span class="event-badge">{event.category}</span>
                </div>
                <div class="event-content">
                  <div class="event-meta">
                    <span class="event-date">{event.date}</span>
                  </div>
                  <a href={`/events/${event.id}/`} class="event-card-title-link"><h3>{event.title}</h3></a>
                  <p>{event.description}</p>
                  <div class="event-footer">
                    <div class="event-price">
                      <span class="price-label">Est. Travel Cost</span>
                      <span class="price-value">{event.priceEstimate}</span>
                    </div>
                    <a href={`/events/${event.id}/`} class="btn btn-outline">View Event</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <!-- Hotel CTA -->
  <section class="hotel-cta-section">
    <div class="container">
      <div class="hotel-cta-card">
        <h2>Find Hotels in {city}</h2>
        <p>Compare prices and book your stay in {city}. We may earn a small commission when you book through our links.</p>
        <a href={hotelUrl} class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer sponsored">Find Hotels in {city}</a>
      </div>
    </div>
  </section>

  <!-- Things To Do -->
  {activityUrl && (
    <section class="activities-section">
      <div class="container">
        <div class="activities-card">
          <h2>Things To Do in {city}</h2>
          <p>Explore local experiences, tours, and attractions around {city}.</p>
          <a href={activityUrl} class="btn btn-green" data-affiliate="viator" data-campaign={`city-${slug}`} data-destination="viator" target="_blank" rel="noopener noreferrer sponsored">Explore {city} Experiences</a>
        </div>
      </div>
    </section>
  )}

  <!-- Related Cities -->
  {relatedCities.length > 0 && (
    <section class="related-section">
      <div class="container">
        <h2>More Cities in {continent}</h2>
        <div class="related-grid">
          {relatedCities.map(rc => (
            <a href={`/cities/${rc.slug}/`} class="related-card">
              <div class="related-body">
                <h3>{rc.city}</h3>
                <p>{rc.country}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- More on MatchTrip -->
  {content && (
    <section class="related-section">
      <div class="container">
        <h2>More on MatchTrip</h2>
        <div class="more-links-grid">
          <a href="/guides/" class="more-link-card">
            <span class="more-link-tag">Guides</span>
            <h3>Travel Guides</h3>
            <p>Destination guides for sports cities around the world.</p>
          </a>
          <a href="/venues/" class="more-link-card">
            <span class="more-link-tag">Venues</span>
            <h3>Venue Guides</h3>
            <p>Seating, transport, and match-day tips for iconic stadiums and arenas.</p>
          </a>
          <a href="/events/" class="more-link-card">
            <span class="more-link-tag">Events</span>
            <h3>All Events</h3>
            <p>Every major sporting event you can build a trip around.</p>
          </a>
          {linkedVenues.map(v => (
            <a href={`/venues/${v.venueSlug}/`} class="more-link-card">
              <span class="more-link-tag">Venue</span>
              <h3>{v.name}</h3>
              <p>Capacity, how to get there, where to sit, and where to stay.</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Plan & Budget guides + city events (all cities) -->
  <section class="related-section">
    <div class="container">
      <h2>Plan Your {city} Sports Trip</h2>
      <div class="more-links-grid">
        <a href="/guides/sports-travel-planning/" class="more-link-card">
          <span class="more-link-tag">Guide</span>
          <h3>Sports Travel Planning</h3>
          <p>Tickets, hotels, flights — the complete planning playbook.</p>
        </a>
        <a href="/guides/sports-travel-budget/" class="more-link-card">
          <span class="more-link-tag">Guide</span>
          <h3>Sports Travel Budget</h3>
          <p>What sports trips really cost at every budget level.</p>
        </a>
        <a href="/guides/best-sports-cities/" class="more-link-card">
          <span class="more-link-tag">Guide</span>
          <h3>Best Sports Cities</h3>
          <p>How {city} compares to the world's great sports cities.</p>
        </a>
        {planEventCards.map(ev => (
          <a href={`/events/${ev.id}/`} class="more-link-card">
            <span class="more-link-tag">Event</span>
            <h3>{ev.title}</h3>
            <p>Travel guide, tickets &amp; hotels{ev.date ? ` · ${ev.date}` : ''}.</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- More Events to Explore (only for cities with fewer than two events of their own) -->
  {moreEvents.length > 0 && (
    <section class="related-section">
      <div class="container">
        <h2>More Events to Explore</h2>
        <div class="more-links-grid">
          {moreEvents.map(ev => (
            <a href={`/events/${ev.id}/`} class="more-link-card">
              <span class="more-link-tag">Event</span>
              <h3>{ev.title}</h3>
              <p>{ev.location?.city}, {ev.location?.country} — travel guide, tickets &amp; hotels.</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Venue guides -->
  <section class="related-section">
    <div class="container">
      <h2>Venue Guides</h2>
      <div class="more-links-grid">
        {planVenueCards.map(v => (
          <a href={`/venues/${v.slug}/`} class="more-link-card">
            <span class="more-link-tag">Venue</span>
            <h3>{v.name}</h3>
            <p>{v.cityDisplay}, {v.country} — seating, transport and match-day tips.</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Fragment set:html={schemaHtml} />
  <Footer />
</Layout>

<style>
  .city-hero {
    padding: 100px 0 60px;
    text-align: center;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }

  .back-link {
    display: inline-block;
    color: #6366f1;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 24px;
    transition: color 0.2s;
  }
  .back-link:hover { color: #4f46e5; }

  .city-hero h1 {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -1px;
    margin-bottom: 8px;
    color: #111;
  }

  .city-country {
    font-size: 1.1rem;
    color: #6366f1;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .city-count {
    font-size: 0.95rem;
    color: #6b7280;
    margin-bottom: 16px;
  }

  .city-subtitle {
    font-size: 1.0625rem;
    color: #6b7280;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .city-hero-img {
    width: 100%;
    margin-top: 32px;
  }

  .city-hero-img img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    object-fit: cover;
  }

  .narrow {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .city-intro {
    padding: 0 0 40px;
  }

  .city-intro p {
    color: #4b5563;
    font-size: 1.05rem;
    line-height: 1.8;
    text-align: center;
  }

  /* City Guide Content (Sports Culture, Venues, Transport, Stay, Tips) */
  .guide-section {
    padding: 0 0 60px;
  }

  .guide-section h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 24px;
  }

  .guide-text {
    color: #4b5563;
    font-size: 1.05rem;
    line-height: 1.8;
    text-align: center;
  }

  .venue-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
  }

  .venue-list li {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    padding: 10px 20px;
    font-size: 0.95rem;
    font-weight: 600;
    transition: border-color 0.2s, background 0.2s;
  }

  .venue-list li:hover {
    border-color: #6366f1;
    background: #f5f3ff;
  }

  .venue-list a {
    color: #4f46e5;
    text-decoration: none;
  }

  .venue-list a:hover {
    text-decoration: underline;
  }

  .venue-list span {
    color: #374151;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .guide-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 24px;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .guide-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.08);
  }

  .transport-mode {
    display: inline-block;
    background: #eef2ff;
    color: #4f46e5;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .airport-head {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .airport-code {
    display: inline-block;
    background: #eef2ff;
    color: #4f46e5;
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 6px 16px;
    border-radius: 12px;
    white-space: nowrap;
  }

  .airport-name {
    margin: 0;
  }

  .guide-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #111;
    margin: 0 0 10px;
  }

  .guide-card p {
    color: #4b5563;
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
  }

  .guide-card-link {
    display: inline-block;
    margin-top: 16px;
  }

  .tips-list {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
