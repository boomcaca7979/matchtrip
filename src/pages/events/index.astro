---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { eventsData } from '../../data/events';

const events = Object.entries(eventsData).map(([id, data]) => ({
  id,
  title: data.title,
  category: data.category,
  location: data.location?.label || data.location,
  date: data.date,
  description: data.description,
  priceEstimate: data.priceEstimate,
  colorFrom: data.colorFrom,
  colorTo: data.colorTo,
  emoji: data.emoji,
}));

// CollectionPage structured data for SEO
const eventsPageUrl = new URL('/events/', Astro.site).href;
const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Sports Events 2026: Football, F1 & Tennis Fixtures",
  "description": "Discover 2026 sports events including football tournaments, F1 races, NBA Finals, Wimbledon & more. View schedules, dates, and match details updated regularly.",
  "url": eventsPageUrl,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": events.map((event, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": new URL('/events/' + event.id + '/', Astro.site).href,
      "name": event.title + " Schedule",
    })),
  },
};

const collectionPageHtml = `<script type="application/ld+json">${JSON.stringify(collectionPageSchema, null, '\t')}</script>`;

const categories = ['All', ...new Set(events.map(e => e.category))];
---

<Layout title="Sports Events 2026: Football, F1 & Tennis Fixtures" description="Discover 2026 sports events including football tournaments, F1 races, NBA Finals, Wimbledon & more. View schedules, dates, and match details updated regularly.">
  <Navbar />

  <section class="events-hero">
    <div class="container">
      <p class="overline">Global Sporting Calendar 2026</p>
      <h1>Sports Events 2026 Schedule</h1>
      <p class="subtitle">
        Explore the biggest sports events in 2026 including football tournaments, Formula 1 races, NBA Finals, Wimbledon, and global championships. Find updated schedules, match dates, and key event information in one place.
      </p>

      <div class="search-bar">
        <input type="text" id="searchInput" placeholder="Search events, cities, or sports..." aria-label="Search events" />
        <select id="categoryFilter" aria-label="Filter by category">
          {categories.map(cat => (
            <option value={cat === 'All' ? '' : cat}>{cat}</option>
          ))}
        </select>
      </div>
    </div>
  </section>

  <!-- Topic Cluster: Hub-and-Spoke Navigation -->
  <section class="topic-cluster">
    <div class="container">
      <h2 class="cluster-heading">Browse by Sport</h2>
      <div class="cluster-grid">
        <a href="/events/football/" class="cluster-card">
          <span class="cluster-icon">⚽</span>
          <span class="cluster-label">Football Events 2026</span>
          <span class="cluster-count">2 events</span>
        </a>
        <a href="/events/f1/" class="cluster-card">
          <span class="cluster-icon">🏎️</span>
          <span class="cluster-label">F1 2026 Schedule</span>
          <span class="cluster-count">2 events</span>
        </a>
        <a href="/events/nba/" class="cluster-card">
          <span class="cluster-icon">🏀</span>
          <span class="cluster-label">NBA Finals 2026</span>
          <span class="cluster-count">1 event</span>
        </a>
        <a href="/events/tennis/" class="cluster-card">
          <span class="cluster-icon">🎾</span>
          <span class="cluster-label">Tennis Tournaments 2026</span>
          <span class="cluster-count">2 events</span>
        </a>
      </div>
    </div>
  </section>

  <section class="events-section">
    <div class="container">
      <div class="events-header">
        <h2>Upcoming Events</h2>
        <p class="events-count"><span id="eventsCount">{events.length}</span> events found</p>
      </div>

      <div class="events-grid" id="eventsGrid">
        {events.map(event => (
          <article class="event-card" data-category={event.category} data-title={event.title.toLowerCase()} data-location={event.location.toLowerCase()}>
            <div class="event-image" style={`background: linear-gradient(135deg, ${event.colorFrom} 0%, ${event.colorTo} 100%)`}>
              <span class="event-emoji">{event.emoji}</span>
              <span class="event-badge">{event.category}</span>
            </div>
            <div class="event-content">
              <div class="event-meta">
                <span class="event-date">{event.date}</span>
                <span class="event-location">{event.location}</span>
              </div>
              <a href={`/events/${event.id}/`} class="event-card-title-link"><h3>{event.title} Schedule</h3></a>
              <p>{event.description}</p>
              <div class="event-footer">
                <div class="event-price">
                  <span class="price-label">Est. Travel Cost</span>
                  <span class="price-value">{event.priceEstimate}</span>
                </div>
                <a href={`/events/${event.id}/`} class="btn btn-primary">Plan Trip</a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <p class="no-results" id="noResults" style="display:none;">No events match your search. Try a different keyword or category.</p>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <div class="cta-card">
        <h2>Can't find your event?</h2>
        <p>We're adding new events every week. Check back soon for more destinations.</p>
      </div>
    </div>
  </section>


		<!-- Schema.org CollectionPage -->
		<Fragment set:html={collectionPageHtml} />
  <Footer />
</Layout>

<style>
  .events-hero {
    padding: 100px 0 48px;
    text-align: center;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }

  .overline {
    font-size: 0.875rem;
    font-weight: 600;
    color: #6366f1;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }

  .events-hero h1 {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -1px;
    margin-bottom: 20px;
    color: #111;
  }

  .subtitle {
    font-size: 1.0625rem;
    color: #6b7280;
    max-width: 640px;
    margin: 0 auto 40px;
    line-height: 1.7;
  }

  .search-bar {
    display: flex;
    gap: 12px;
    max-width: 640px;
    margin: 0 auto;
  }

  .search-bar input {
    flex: 1;
    padding: 14px 20px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    font-family: inherit;
  }

  .search-bar input:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
  }

  .search-bar select {
    padding: 14px 20px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    font-size: 1rem;
    background: white;
    cursor: pointer;
    outline: none;
    font-family: inherit;
  }

  .topic-cluster {
    padding: 0 0 48px;
    background: #ffffff;
  }

  .cluster-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 24px;
    text-align: center;
  }

  .cluster-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    max-width: 800px;
    margin: 0 auto;
  }

  .cluster-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 24px 16px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    text-decoration: none;
    transition: all 0.25s ease;
    text-align: center;
  }

  .cluster-card:hover {
    border-color: #6366f1;
    background: #f5f3ff;
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.1);
  }

  .cluster-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .cluster-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #111;
  }

  .cluster-count {
    font-size: 0.75rem;
    color: #6b7280;
    font-weight: 500;
  }

  .events-section {
    padding: 48px 0 80px;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .events-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .events-header h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #111;
  }

  .events-count {
    color: #6b7280;
    font-size: 0.95rem;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 24px;
  }

  .event-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .event-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.1);
  }

  .event-image {
    position: relative;
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .event-emoji {
    font-size: 3.5rem;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));
  }

  .event-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(255, 255, 255, 0.95);
    color: #111;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .event-content {
    padding: 24px;
  }

  .event-meta {
    display: flex;
    gap: 16px;
    margin-bottom: 12px;
    font-size: 0.85rem;
    color: #6b7280;
  }

  .event-card-title-link {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: color 0.2s ease;
  }

  .event-card-title-link:hover {
    color: #6366f1;
  }

  .event-card-title-link h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: #111;
  }

  .event-content p {
    color: #4b5563;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .event-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid #f3f4f6;
  }

  .event-price {
    display: flex;
    flex-direction: column;
  }

  .price-label {
    font-size: 0.75rem;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .price-value {
    font-size: 1rem;
    font-weight: 700;
    color: #111;
  }

  .no-results {
    text-align: center;
    color: #6b7280;
    padding: 48px 0;
    font-size: 1.05rem;
  }

  .cta-section {
    padding: 0 0 80px;
  }

  .cta-card {
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
    border-radius: 24px;
    padding: 64px;
    text-align: center;
    color: white;
  }

  .cta-card h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .cta-card p {
    color: #94a3b8;
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background: #111;
    color: white;
    padding: 10px 20px;
    border-radius: 10px;
    border: none;
    font-size: 0.9rem;
  }

  .btn-primary:hover {
    background: #374151;
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .events-hero h1 { font-size: 2.25rem; }
    .events-grid { grid-template-columns: 1fr; }
    .search-bar { flex-direction: column; }
    .cta-card { padding: 40px 24px; }
    .cluster-grid { grid-template-columns: repeat(2, 1fr); max-width: 100%; }
  }

  @media (max-width: 480px) {
    .cluster-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
    .cluster-card { padding: 18px 12px; }
  }
</style>

<script>
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const categoryFilter = document.getElementById('categoryFilter') as HTMLSelectElement;
  const eventsGrid = document.getElementById('eventsGrid');
  const eventsCount = document.getElementById('eventsCount');
  const noResults = document.getElementById('noResults');

  if (eventsGrid) {
    const cards = eventsGrid.querySelectorAll('.event-card');

    function filterEvents() {
      const query = searchInput?.value.toLowerCase() ?? '';
      const category = categoryFilter?.value ?? '';
      let visibleCount = 0;

      cards.forEach(card => {
        const el = card as HTMLElement;
        const title = el.dataset.title ?? '';
        const location = el.dataset.location ?? '';
        const cardCategory = el.dataset.category ?? '';

        const matchesSearch = title.includes(query) || location.includes(query);
        const matchesCategory = !category || cardCategory === category;

        const visible = matchesSearch && matchesCategory;
        el.style.display = visible ? '' : 'none';
        if (visible) visibleCount++;
      });

      if (eventsCount) eventsCount.textContent = String(visibleCount);
      if (noResults) noResults.style.display = visibleCount === 0 ? '' : 'none';
    }

    searchInput?.addEventListener('input', filterEvents);
    categoryFilter?.addEventListener('change', filterEvents);
  }
</script>
