---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { eventsData } from '../../../data/events';

const categoryEvents = Object.entries(eventsData)
  .filter(([, data]) => data.category === 'Football')
  .map(([id, data]) => ({ id, ...data, location: data.location?.label || data.location }));

const categoryUrl = new URL('/events/football', Astro.site).href;

// CollectionPage structured data
const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Football Events 2026 – World Cup & Champions League",
  "description": "Discover football events in 2026 – FIFA World Cup across North America and the Champions League Final. View schedules, dates, and match fixture info.",
  "url": categoryUrl,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": categoryEvents.map((event, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": new URL('/events/' + event.id, Astro.site).href,
      "name": event.title,
    })),
  },
};

const schemaHtml = `<script type="application/ld+json">${JSON.stringify(collectionPageSchema, null, '\t')}</script>`;
---

<Layout
  title="Football Events 2026 – World Cup & Champions League | MatchTrip"
  description="Discover football events in 2026 – FIFA World Cup across North America and the Champions League Final. View schedules, dates, and match fixture info."
  canonical="/sports/football/"
>
  <Navbar />

  <!-- Hero -->
  <section class="category-hero">
    <div class="container">
      <a href="/events/" class="back-link">&larr; All Events</a>
      <p class="overline">Sport Category</p>
      <h1>Football Events 2026</h1>
      <p class="subtitle">Discover the biggest football tournaments in 2026. From the FIFA World Cup across North America to the Champions League Final in Budapest, track schedules, dates, and travel guides for football's most anticipated events.</p>
    </div>
  </section>

  <!-- Topic Cluster: Back to Hub + Other Categories -->
  <section class="topic-cluster">
    <div class="container">
      <h2 class="cluster-heading">Browse All Sports</h2>
      <div class="cluster-grid">
        <a href="/events/" class="cluster-card cluster-card-hub">
          <span class="cluster-label">All Events Hub</span>
        </a>
        <a href="/events/football/" class="cluster-card">
          <span class="cluster-icon">⚽</span>
          <span class="cluster-label">Football Events 2026</span>
        </a>
        <a href="/events/f1/" class="cluster-card">
          <span class="cluster-icon">🏎️</span>
          <span class="cluster-label">F1 2026 Schedule</span>
        </a>
        <a href="/events/nba/" class="cluster-card">
          <span class="cluster-icon">🏀</span>
          <span class="cluster-label">NBA Finals 2026</span>
        </a>
        <a href="/events/tennis/" class="cluster-card">
          <span class="cluster-icon">🎾</span>
          <span class="cluster-label">Tennis Tournaments 2026</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Events Grid -->
  <section class="events-section">
    <div class="container">
      <div class="events-header">
        <h2>Football Events 2026</h2>
        <p class="events-count">{categoryEvents.length} event(s)</p>
      </div>

      <div class="events-grid">
        {categoryEvents.map(event => (
          <article class="event-card">
            <div class="event-image" style={`background: linear-gradient(135deg, ${event.colorFrom} 0%, ${event.colorTo} 100%)`}>
              <span class="event-emoji">{event.emoji}</span>
              <span class="event-badge">{event.category}</span>
            </div>
            <div class="event-content">
              <div class="event-meta">
                <span class="event-date">{event.date}</span>
                <span class="event-location">{event.location}</span>
              </div>
              <a href={`/events/${event.id}/`} class="event-card-title-link"><h3>{event.title} Schedule</h3></a>
              <p>{event.description}</p>
              <div class="event-footer">
                <div class="event-price">
                  <span class="price-label">Est. Travel Cost</span>
                  <span class="price-value">{event.priceEstimate}</span>
                </div>
                <a href={`/events/${event.id}`} class="btn btn-primary">Plan Trip</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Fragment set:html={schemaHtml} />
  <Footer />
</Layout>

<style>
  .category-hero {
    padding: 80px 0 40px;
    text-align: center;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }

  .back-link {
    display: inline-block;
    color: #6366f1;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 24px;
    transition: color 0.2s;
  }

  .back-link:hover { color: #4f46e5; }

  .overline {
    font-size: 0.875rem;
    font-weight: 600;
    color: #6366f1;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 12px;
  }

  .category-hero h1 {
    font-size: 2.75rem;
    font-weight: 800;
    letter-spacing: -0.5px;
    margin-bottom: 16px;
    color: #111;
  }

  .subtitle {
    font-size: 1.0625rem;
    color: #6b7280;
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .topic-cluster {
    padding: 0 0 48px;
    background: #ffffff;
  }

  .cluster-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 20px;
    text-align: center;
  }

  .cluster-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    max-width: 800px;
    margin: 0 auto;
  }

  .cluster-card {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 100px;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    color: #111;
    transition: all 0.2s ease;
  }

  .cluster-card:hover {
    border-color: #6366f1;
    background: #f5f3ff;
    color: #6366f1;
  }

  .cluster-card-hub {
    background: #111827;
    border-color: #111827;
    color: white;
  }

  .cluster-card-hub:hover {
    background: #374151;
    border-color: #374151;
    color: white;
  }

  .cluster-icon { font-size: 1.125rem; }

  .events-section {
    padding: 0 0 80px;
  }

  .events-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .events-header h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111;
  }

  .events-count {
    color: #6b7280;
    font-size: 0.95rem;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 24px;
  }

  .event-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .event-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.1);
  }

  .event-image {
    position: relative;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .event-emoji {
    font-size: 3rem;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));
  }

  .event-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(255, 255, 255, 0.95);
    color: #111;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .event-content {
    padding: 24px;
  }

  .event-meta {
    display: flex;
    gap: 16px;
    margin-bottom: 10px;
    font-size: 0.85rem;
    color: #6b7280;
  }

  .event-card-title-link {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: color 0.2s ease;
  }

  .event-card-title-link:hover { color: #6366f1; }

  .event-card-title-link h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: #111;
  }

  .event-content p {
    color: #4b5563;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .event-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid #f3f4f6;
  }

  .event-price {
    display: flex;
    flex-direction: column;
  }

  .price-label {
    font-size: 0.75rem;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .price-value {
    font-size: 1rem;
    font-weight: 700;
    color: #111;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background: #111;
    color: white;
    padding: 10px 20px;
    border-radius: 10px;
    border: none;
    font-size: 0.9rem;
  }

  .btn-primary:hover {
    background: #374151;
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .category-hero h1 { font-size: 2rem; }
    .events-grid { grid-template-columns: 1fr; }
    .cluster-grid { gap: 8px; }
  }
</style>
