---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { eventsData } from '../../../data/events';

const categoryEvents = Object.entries(eventsData)
  .filter(([, data]) => data.category === 'Football')
  .map(([id, data]) => ({ id, ...data, location: data.location?.label || data.location }));

const categoryUrl = new URL('/events/football/', Astro.site).href;

// CollectionPage structured data
const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Football Events 2026 – World Cup & Champions League",
  "description": "Discover football events in 2026 – FIFA World Cup across North America and the Champions League Final. View schedules, dates, and match fixture info.",
  "url": categoryUrl,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": categoryEvents.map((event, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": new URL('/events/' + event.id + '/', Astro.site).href,
      "name": event.title,
    })),
  },
};

const schemaHtml = `<script type="application/ld+json">${JSON.stringify(collectionPageSchema, null, '\t')}</script>`;
---

<Layout
  title="Football Events 2026 – World Cup & Champions League | MatchTrip"
  description="Discover football events in 2026 – FIFA World Cup across North America and the Champions League Final. View schedules, dates, and match fixture info."
>
  <Navbar />

  <!-- Hero -->
  <section class="category-hero">
    <div class="container">
      <a href="/events/" class="back-link">&larr; All Events</a>
      <p class="overline">Sport Category</p>
      <h1>Football Events 2026</h1>
      <p class="subtitle">Discover the biggest football tournaments in 2026. From the FIFA World Cup across North America to the Champions League Final in Budapest, track schedules, dates, and travel guides for football's most anticipated events.</p>
    </div>
  </section>

  <!-- Introduction -->
  <section class="intro-section">
    <div class="container">
      <h2 class="section-heading">Why Football Is the Sport Worth Traveling For</h2>
      <p>No other sport moves travelers like football. The current cycle delivered the two biggest trips in the game: the FIFA World Cup 2026, the first edition expanded to 48 teams and the first ever staged across three nations — the United States, Canada, and Mexico, with the final at MetLife Stadium on July 19, 2026 — and the Champions League Final 2026 at Budapest's Puskás Arena on May 30, the biggest single club match on earth. The 2027 final is already locked in for the Riyadh Air Metropolitano in Madrid on June 5, giving fans a full year to plan a European summer around it.</p>
      <p>Football rewards the traveling fan in a way no other sport does, because the match day rewrites the city around it. Metro carriages fill with scarves hours before kick-off, central squares become ticketed fan zones with giant screens, and bars set their entire evening to the rhythm of the whistle. A World Cup multiplies that energy across sixteen host cities and a month of matches; a Champions League final compresses it into one weekend where two sets of supporters take over an entire capital.</p>
      <p>The three trips below span the full range of football travel — a three-nation, sixteen-city World Cup; a one-night final in Budapest; and the next final in Madrid, the city with more European Cups than any other. Each pairs the match with a destination worth a week of your time.</p>
    </div>
  </section>

  <!-- Topic Cluster: Back to Hub + Other Categories -->
  <section class="topic-cluster">
    <div class="container">
      <h2 class="cluster-heading">Browse All Sports</h2>
      <div class="cluster-grid">
        <a href="/events/" class="cluster-card cluster-card-hub">
          <span class="cluster-label">All Events Hub</span>
        </a>
        <a href="/events/football/" class="cluster-card">
          <span class="cluster-icon">⚽</span>
          <span class="cluster-label">Football Events 2026</span>
        </a>
        <a href="/events/f1/" class="cluster-card">
          <span class="cluster-icon">🏎️</span>
          <span class="cluster-label">F1 2026 Schedule</span>
        </a>
        <a href="/events/nba/" class="cluster-card">
          <span class="cluster-icon">🏀</span>
          <span class="cluster-label">NBA Finals 2026</span>
        </a>
        <a href="/events/tennis/" class="cluster-card">
          <span class="cluster-icon">🎾</span>
          <span class="cluster-label">Tennis Tournaments 2026</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Events Grid -->
  <section class="events-section">
    <div class="container">
      <div class="events-header">
        <h2>Football Events 2026</h2>
        <p class="events-count">{categoryEvents.length} event(s)</p>
      </div>

      <p class="events-intro">MatchTrip tracks the three football blockbusters of the current cycle: the <a href="/events/world-cup-2026/">FIFA World Cup 2026</a> across North America, the <a href="/events/champions-league-final/">Champions League Final 2026</a> at Budapest's Puskás Arena, and the <a href="/events/champions-league-final-2027/">2027 final</a> at Madrid's Metropolitano. Each guide covers ticket ballots, host-city neighborhoods, transport to the stadium, and what the trip realistically costs.</p>

      <div class="events-grid">
        {categoryEvents.map(event => (
          <article class="event-card">
            <div class="event-image" style={`background: linear-gradient(135deg, ${event.colorFrom} 0%, ${event.colorTo} 100%)`}>
              <span class="event-emoji">{event.emoji}</span>
              <span class="event-badge">{event.category}</span>
            </div>
            <div class="event-content">
              <div class="event-meta">
                <span class="event-date">{event.date}</span>
                <span class="event-location">{event.location}</span>
              </div>
              <a href={`/events/${event.id}/`} class="event-card-title-link"><h3>{event.title} Schedule</h3></a>
              <p>{event.description}</p>
              <p class="event-travel-intel">Held at {event.venues?.[0] || 'the host stadium'} — plan for flights {event.avgFlightPrice}, hotels from {event.avgHotelPrice} per night, and match tickets {event.matchTickets}. Book refundable rates early; football finals bend hotel markets hardest the week the teams are confirmed.</p>
              <div class="event-footer">
                <div class="event-price">
                  <span class="price-label">Est. Travel Cost</span>
                  <span class="price-value">{event.priceEstimate}</span>
                </div>
                <a href={`/events/${event.id}/`} class="btn btn-primary">Plan Trip</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Final Culture -->
  <section class="content-section">
    <div class="container">
      <h2 class="section-heading">The Culture of a Football Final</h2>
      <p>A football final is not a ninety-minute appointment — it is a city-scale ritual with a match at its center. The day begins in fan zones, where both supporter camps set up stages, chants, and beer gardens from mid-morning, and builds through stadium marches that turn entire avenues into a wall of colors. At a Champions League final, half the stadium arrives from abroad: the two finalists each receive a large ticket allocation, so the host city fills with visiting supporters who spend the whole weekend singing, sightseeing, and taking over the central squares. By the time kick-off arrives — 9 PM for most Champions League finals — the stadium has been the loudest room in Europe for an hour.</p>
      <p>The World Cup scales that culture across a month and three nations. In 2026, sixteen host cities from Vancouver to Mexico City each ran their own fan festivals, and the tournament's 48-team format meant more matches, more minnows with traveling armies, and more days when an entire downtown belonged to one country's fans. Wherever you watch, the post-match matters as much as the pre-match: wins turn city centers into impromptu carnivals, and even defeats end in bars that stay open until the metro restarts. Plan your nights accordingly.</p>
    </div>
  </section>

  <!-- Travel Planning -->
  <section class="content-section">
    <div class="container">
      <h2 class="section-heading">Football Travel Planning</h2>

      <h3 class="sub-heading">Tickets: Ballots, Phases, and Official Channels</h3>
      <p>Big football matches sell in very different ways, so strategy starts with knowing the system. FIFA released World Cup inventory in phases across more than a year — the pattern repeats for future tournaments, so register early and track each sales window. UEFA runs a public ballot for the Champions League final that opens months ahead; enter as soon as it launches, and expect a second members-only window if your club reaches the final, since finalist clubs receive the largest allocations. Official face-value tickets for the final run roughly €70 to €690 by category, while resale listings after the semifinals jump to €600-3,000 and beyond — buy only from marketplaces with authenticity guarantees, and compare their all-in totals against official hospitality, which sometimes wins once fees are counted.</p>

      <h3 class="sub-heading">Hotels: Book Refundable, Then Reprice</h3>
      <p>Accommodation is the biggest line in any football travel budget, and final weekends bend the market hard: rooms near major grounds routinely double or triple when the match comes to town, and hotel rates in the host city surge 200-300% in the week the finalists are confirmed. Book refundable rooms the day dates are announced, then reprice as the match approaches. The reliable counter-strategy is distance — staying three or four metro stops from the stadium typically halves the rate while adding ten minutes to match day. In Madrid, the San Blas district around the Metropolitano trades city-center charm for walkable stadium access at fairer prices; in Budapest, districts on the metro's east side reach the Puskás Arena in twenty minutes. For tournament-scale travel, pick one host city as a base for group games rather than chasing fixtures across a country, and expect two-to-three night minimums everywhere on final weekend.</p>

      <h3 class="sub-heading">Getting to the Ground</h3>
      <p>Football cities reward transit over driving. Almost every major stadium sits on a metro or suburban rail line — the Metropolitano has its own stop on Madrid's Line 7, Wembley Park is served by two tube lines, and the Puskás Arena sits above the M2 at Puskás Ferenc Stadion station — so buy a rechargeable transit card on day one and skip the rental car entirely. Arrive early: security lines at finals run thirty to sixty minutes, and the pre-match fan zones are half the experience. Afterwards, do what locals do — walk fifteen minutes away from the ground before hailing a rideshare, since surge pricing outside stadiums can double fares, and metro platforms clear within the hour. Cross-border fixtures and three-nation World Cups mean passport checks and border queues; build buffer time into every transfer and keep your ticket's digital wallet working offline.</p>
    </div>
  </section>

  <!-- Related Guides -->
  <section class="content-section related-section">
    <div class="container">
      <h2 class="section-heading">Related Guides</h2>
      <p>Extend the trip with MatchTrip's wider guide network. The <a href="/guides/sports-travel-planning/">sports travel planning guide</a> walks through booking timelines and refundable-rate strategy for final weekends, while the <a href="/guides/sports-travel-budget/">sports travel budget guide</a> breaks down what football trips actually cost by category. Browse the <a href="/guides/">guides hub</a> for destination coverage, and see the <a href="/sports/football/">football sports page</a> for the full collection of football cities and venues. Year hubs pull the calendar together — <a href="/events/2026/">2026 events</a> for the World Cup summer and <a href="/events/2027/">2027 events</a> for the Madrid final — and if you are stacking sports on one trip, the <a href="/events/f1/">Formula 1 schedule</a>, <a href="/events/tennis/">tennis tournaments</a>, and <a href="/events/nba/">NBA Finals</a> collections all pair well with a European summer.</p>
    </div>
  </section>

  <Fragment set:html={schemaHtml} />
  <Footer />
</Layout>

<style>
  .category-hero {
    padding: 80px 0 40px;
    text-align: center;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }

  .back-link {
    display: inline-block;
    color: #6366f1;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 24px;
    transition: color 0.2s;
  }

  .back-link:hover { color: #4f46e5; }

  .overline {
    font-size: 0.875rem;
    font-weight: 600;
    color: #6366f1;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 12px;
  }

  .category-hero h1 {
    font-size: 2.75rem;
    font-weight: 800;
    letter-spacing: -0.5px;
    margin-bottom: 16px;
    color: #111;
  }

  .subtitle {
    font-size: 1.0625rem;
    color: #6b7280;
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .intro-section {
    padding: 24px 0 48px;
  }

  .section-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 20px;
    padding-bottom: 8px;
    border-bottom: 2px solid #f3f4f6;
  }

  .intro-section p,
  .content-section p {
    color: #4b5563;
    font-size: 1rem;
    line-height: 1.75;
    margin: 0 0 16px;
  }

  .content-section {
    padding: 0 0 56px;
  }

  .content-section p a,
  .events-intro a {
    color: #6366f1;
    font-weight: 600;
    text-decoration: none;
  }

  .content-section p a:hover,
  .events-intro a:hover {
    color: #4f46e5;
    text-decoration: underline;
  }

  .sub-heading {
    font-size: 1.15rem;
    font-weight: 700;
    color: #111;
    margin: 28px 0 12px;
  }

  .topic-cluster {
    padding: 0 0 48px;
    background: #ffffff;
  }

  .cluster-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 20px;
    text-align: center;
  }

  .cluster-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    max-width: 800px;
    margin: 0 auto;
  }

  .cluster-card {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 100px;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    color: #111;
    transition: all 0.2s ease;
  }

  .cluster-card:hover {
    border-color: #6366f1;
    background: #f5f3ff;
    color: #6366f1;
  }

  .cluster-card-hub {
    background: #111827;
    border-color: #111827;
    color: white;
  }

  .cluster-card-hub:hover {
    background: #374151;
    border-color: #374151;
    color: white;
  }

  .cluster-icon { font-size: 1.125rem; }

  .events-section {
    padding: 0 0 56px;
  }

  .events-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .events-header h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111;
  }

  .events-count {
    color: #6b7280;
    font-size: 0.95rem;
  }

  .events-intro {
    color: #4b5563;
    font-size: 1rem;
    line-height: 1.75;
    margin-bottom: 28px;
    max-width: 860px;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 24px;
  }

  .event-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .event-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.1);
  }

  .event-image {
    position: relative;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .event-emoji {
    font-size: 3rem;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));
  }

  .event-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(255, 255, 255, 0.95);
    color: #111;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .event-content {
    padding: 24px;
  }

  .event-meta {
    display: flex;
    gap: 16px;
    margin-bottom: 10px;
    font-size: 0.85rem;
    color: #6b7280;
  }

  .event-card-title-link {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: color 0.2s ease;
  }

  .event-card-title-link:hover { color: #6366f1; }

  .event-card-title-link h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: #111;
  }

  .event-content p {
    color: #4b5563;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 12px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .event-travel-intel {
    color: #6b7280;
    font-size: 0.85rem;
    line-height: 1.6;
    margin-bottom: 20px;
    display: block;
  }

  .event-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid #f3f4f6;
  }

  .event-price {
    display: flex;
    flex-direction: column;
  }

  .price-label {
    font-size: 0.75rem;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .price-value {
    font-size: 1rem;
    font-weight: 700;
    color: #111;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background: #111;
    color: white;
    padding: 10px 20px;
    border-radius: 10px;
    border: none;
    font-size: 0.9rem;
  }

  .btn-primary:hover {
    background: #374151;
    transform: translateY(-1px);
  }

  .related-section {
    padding-bottom: 72px;
  }

  @media (max-width: 768px) {
    .category-hero h1 { font-size: 2rem; }
    .events-grid { grid-template-columns: 1fr; }
    .cluster-grid { gap: 8px; }
  }
</style>
