---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { eventsData } from '../../data/events';

export function getStaticPaths() {
  const yearMap = new Map();

  Object.entries(eventsData).forEach(([id, event]) => {
    if (!event.year) return;
    if (!yearMap.has(event.year)) {
      yearMap.set(event.year, []);
    }
    yearMap.get(event.year).push({ id, ...event });
  });

  return Array.from(yearMap.entries()).map(([year, events]) => ({
    params: { year: String(year) },
    props: { year, events },
  }));
}

const { year, events } = Astro.props;

const pageUrl = new URL(`/events/${year}/`, Astro.site).href;

// Group events by category
const categories = [...new Set(events.map(e => e.category))].sort();
const groupedEvents = categories.map(cat => ({
  category: cat,
  events: events.filter(e => e.category === cat),
}));

const upcomingEvents = events.filter(e => e.status !== 'ended');
const pastEvents = events.filter(e => e.status === 'ended');

const title = `${year} Sports Events Schedule – ${categories.slice(0, 3).join(', ')} | MatchTrip`;
const description = `View the ${year} sports calendar including ${categories.slice(0, 4).join(', ')} events. Find schedules, dates, travel guides, and booking information for major sporting events in ${year}.`;

const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${year} Sports Events`,
  "description": `${year} sports calendar with ${events.length} major events across ${categories.length} sports categories.`,
  "url": pageUrl,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": events.map((event, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": new URL(`/events/${event.id}/`, Astro.site).href,
      "name": event.title,
    })),
  },
};

const schemaHtml = `<script type="application/ld+json">${JSON.stringify(collectionPageSchema, null, '\t')}</script>`;
---

<Layout title={title} description={description}>
  <Navbar />

  <section class="year-hero">
    <div class="container">
      <a href="/events/" class="back-link">&larr; All Events</a>
      <h1>{year} Sports Events</h1>
      <p class="year-count">{events.length} events across {categories.length} sports</p>
      <p class="year-subtitle">Browse the {year} sporting calendar. Find schedules, travel guides, and booking links for the biggest events in {upcomingEvents.length > 0 ? `${upcomingEvents.length} upcoming` : ''}{upcomingEvents.length > 0 && pastEvents.length > 0 ? ' and ' : ''}{pastEvents.length > 0 ? `${pastEvents.length} past` : ''} events.</p>
    </div>
  </section>

  <section class="year-section">
    <div class="container">
      {groupedEvents.map(group => (
        <div class="category-block">
          <h2 class="category-heading">{group.category} Events in {year}</h2>
          <div class="events-grid">
            {group.events.map(event => (
              <article class="event-card">
                <div class="event-image" style={`background: linear-gradient(135deg, ${event.colorFrom || '#6366f1'} 0%, ${event.colorTo || '#a855f7'} 100%)`}>
                  <span class="event-emoji">{event.emoji || '🏟️'}</span>
                  <span class="event-badge">{event.status === 'upcoming' ? 'Upcoming' : 'Ended'}</span>
                </div>
                <div class="event-content">
                  <div class="event-meta">
                    <span class="event-date">{event.date}</span>
                    <span class="event-location">{event.location?.label || event.location}</span>
                  </div>
                  <a href={`/events/${event.id}/`} class="event-card-title-link"><h3>{event.title}</h3></a>
                  <p>{event.description}</p>
                  <div class="event-footer">
                    <div class="event-price">
                      <span class="price-label">Est. Travel Cost</span>
                      <span class="price-value">{event.priceEstimate}</span>
                    </div>
                    <a href={`/events/${event.id}/`} class="btn btn-primary">Plan Trip</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <Fragment set:html={schemaHtml} />
  <Footer />
</Layout>

<style>
  .year-hero {
    padding: 100px 0 60px;
    text-align: center;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }

  .back-link {
    display: inline-block;
    color: #6366f1;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 24px;
    transition: color 0.2s;
  }
  .back-link:hover { color: #4f46e5; }

  .year-hero h1 {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -1px;
    margin-bottom: 8px;
    color: #111;
  }

  .year-count {
    font-size: 0.95rem;
    color: #6366f1;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .year-subtitle {
    font-size: 1.0625rem;
    color: #6b7280;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .year-section {
    padding: 40px 0 80px;
  }

  .category-block {
    margin-bottom: 48px;
  }

  .category-block:last-child {
    margin-bottom: 0;
  }

  .category-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 24px;
    padding-bottom: 8px;
    border-bottom: 2px solid #f3f4f6;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 24px;
  }

  .event-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .event-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.1);
  }

  .event-image {
    position: relative;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .event-emoji {
    font-size: 3rem;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));
  }

  .event-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(255, 255, 255, 0.95);
    color: #111;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .event-content {
    padding: 24px;
  }

  .event-meta {
    display: flex;
    gap: 16px;
    margin-bottom: 10px;
    font-size: 0.85rem;
    color: #6b7280;
    flex-wrap: wrap;
  }

  .event-card-title-link {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: color 0.2s ease;
  }

  .event-card-title-link:hover { color: #6366f1; }

  .event-card-title-link h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: #111;
  }

  .event-content p {
    color: #4b5563;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .event-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid #f3f4f6;
  }

  .event-price {
    display: flex;
    flex-direction: column;
  }

  .price-label {
    font-size: 0.75rem;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .price-value {
    font-size: 1rem;
    font-weight: 700;
    color: #111;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background: #111;
    color: white;
    padding: 10px 20px;
    border-radius: 10px;
    border: none;
    font-size: 0.9rem;
  }

  .btn-primary:hover {
    background: #374151;
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .year-hero h1 { font-size: 2rem; }
    .events-grid { grid-template-columns: 1fr; }
  }
</style>
