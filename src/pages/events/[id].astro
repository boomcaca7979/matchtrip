		<!-- Schema.org Event -->
		<Fragment set:html={eventSchemaHtml} />
		{/* Schema.org Article (only on pages with travelGuide editorial content) */}
		{articleSchemaHtml && <Fragment set:html={articleSchemaHtml} />}
