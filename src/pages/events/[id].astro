		<Fragment set:html={faqSchemaHtml} />
		{/* Schema.org BreadcrumbList: Home > Events > Event */}
		<Fragment set:html={breadcrumbSchemaHtml} />
		{/* Schema.org ImageObject (hero category artwork) */}
		<Fragment set:html={imageSchemaHtml} />
<Footer />
</Layout>

