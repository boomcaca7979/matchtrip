---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import { eventsData } from '../../data/events';
import { venuesData } from '../../data/venues';
import {
  buildHotelLink,
  buildFlightLink,
  buildTicketLink,
  buildOfficialTicketLink,
  buildResaleTicketLinks,
  buildActivityLink,
} from '../../utils/affiliate-links';
import {
  getEventLocation,
  getFlightPrice,
  getHotelPrice,
  getTicketPrice,
  getTravelPrice,
} from '../../utils/eventHelpers';

export function getStaticPaths() {
  return Object.keys(eventsData).map(id => ({ params: { id } }));
}

const { id } = Astro.params;
const event = eventsData[id as keyof typeof eventsData];

if (!event) {
  return Astro.redirect('/events/');
}

// Related venue guide: the venue whose eventIds include this event.
const relatedVenue = Object.values(venuesData).find(v => v.eventIds?.includes(id as string));
const relatedVenueCapacity = relatedVenue && relatedVenue.capacity != null
  ? (typeof relatedVenue.capacity === 'number'
      ? relatedVenue.capacity.toLocaleString('en-US')
      : String(relatedVenue.capacity))
  : null;

// Valid city slugs: city pages are generated from event.location.city — only
// link host cities that actually have a city page (avoid broken links).
const availableCitySlugs = new Set(
  Object.values(eventsData)
    .map(e => e.location?.city?.toLowerCase().replace(/\s+/g, '-'))
    .filter(Boolean)
);
const citySlugOf = (cityName: string) => cityName.toLowerCase().replace(/\s+/g, '-');

// Related city pages: every event page links at least two city guides.
// Same-continent cities come first; the event's own host cities are excluded.
const ownCitySlugs = new Set((event.hostCities || []).map(c => citySlugOf(c)));
const cityPageMap = new Map();
Object.values(eventsData).forEach(e => {
  const c = e.location?.city;
  if (!c) return;
  const s = citySlugOf(c);
  if (!cityPageMap.has(s)) {
    cityPageMap.set(s, { slug: s, city: c, continent: e.location?.continent });
  }
});
const relatedCityLinks = Array.from(cityPageMap.values())
  .filter(c => !ownCitySlugs.has(c.slug))
  .sort((a, b) =>
    (a.continent === event.location?.continent ? 0 : 1) -
    (b.continent === event.location?.continent ? 0 : 1)
  )
  .slice(0, 3);

// Venue guide fallback: when no venue lists this event in eventIds, link a
// venue guide from the same city (e.g. Wimbledon → Wembley), or the venue hub
// as a last resort — every event page keeps at least one venue link.
const eventCitySlug = event.location?.city ? citySlugOf(event.location.city) : null;
const cityVenue = !relatedVenue && eventCitySlug
  ? Object.values(venuesData).find(v => v.citySlug === eventCitySlug) || null
  : null;

// "Best Sports Cities" card copy: the event city when we have one.
const guidesCityLabel = event.location?.city
  || (event.hostCities || []).find(c => availableCitySlugs.has(citySlugOf(c)))
  || null;

const refs = event.partnerRefs;
const campaign = id as string;
const city = event.location?.city || refs.hotelCity || event.hostCities[0] || '';
const stayCity = event.location?.city || refs.hotelCity || '';

// Pass event dates as default checkin/checkout so users land on date-matched search results
const checkin = event.startDate ? event.startDate.split('T')[0] : '';
const checkout = event.endDate ? event.endDate.split('T')[0] : '';
const hotelUrl = buildHotelLink({ city: refs.hotelCity, checkin, checkout, campaign });
const stayHotelUrl = buildHotelLink({ city: stayCity, checkin, checkout, campaign });
const flightUrl = buildFlightLink({ to: refs.flightTo, campaign });
const ticketUrl = buildTicketLink({ url: refs.ticketUrl, slug: refs.ticketSlug, campaign });
const officialTicketUrl = buildOfficialTicketLink({ url: refs.ticketUrl, slug: refs.ticketSlug });
const resaleTicketLinks = buildResaleTicketLinks({
  slug: refs.ticketSlug,
  campaign,
  resaleTickets: refs.resaleTickets,
});
const activityUrl = refs.activityQuery
  ? buildActivityLink({ query: refs.activityQuery, campaign })
  : null;

// Related events: same category first, then same continent. Upcoming events first.
const sortByStatus = (a, b) => {
  const aUpcoming = a[1].status === 'upcoming' ? 0 : 1;
  const bUpcoming = b[1].status === 'upcoming' ? 0 : 1;
  if (aUpcoming !== bUpcoming) return aUpcoming - bUpcoming;
  return (b[1].year || 0) - (a[1].year || 0);
};

const otherEntries = Object.entries(eventsData).filter(([eid]) => eid !== id);
const sameCategory = otherEntries.filter(([, d]) => d.category === event.category).sort(sortByStatus);
const sameContinent = otherEntries.filter(([, d]) =>
  d.category !== event.category &&
  d.location?.continent === event.location?.continent
).sort(sortByStatus);
const fillers = otherEntries.filter(([eid]) =>
  !sameCategory.some(([id]) => id === eid) &&
  !sameContinent.some(([id]) => id === eid)
).sort(sortByStatus);
const otherEvents = [...sameCategory, ...sameContinent, ...fillers]
  .slice(0, 3)
  .map(([eid, data]) => ({ id: eid, ...data }));

// Category mapping for hub-and-spoke linking
const categoryToCluster = {
  'Football': { url: '/events/football/', label: 'Football Events 2026' },
  'Motorsport': { url: '/events/f1/', label: 'F1 2026 Schedule' },
  'Basketball': { url: '/events/nba/', label: 'NBA Finals 2026' },
  'Tennis': { url: '/events/tennis/', label: 'Tennis Tournaments 2026' },
};
const clusterLink = categoryToCluster[event.category as keyof typeof categoryToCluster] || { url: '/events/', label: 'All Events' };

// Hero category image — reuses the OG image mapping from Layout.astro
// (football→football, motorsport/f1→formula1, tennis→tennis, golf→golf, everything else→default).
const OG_IMAGE_BY_CATEGORY = {
  football: 'football',
  motorsport: 'formula1',
  f1: 'formula1',
  tennis: 'tennis',
  golf: 'golf',
};
const heroCategoryKey = String(event.category).trim().toLowerCase().replace(/[\s-]+/g, '-');
const heroImageFile = OG_IMAGE_BY_CATEGORY[heroCategoryKey] || 'default';

// Previous edition (reverse link: upcoming events referencing an earlier edition).
// Only valid when the slug actually resolves to an entry in eventsData.
const previousEventData = event.previousEvent
  ? eventsData[event.previousEvent as keyof typeof eventsData]
  : null;

// Event structured data for SEO (JSON-LD)
const eventUrl = new URL('/events/' + id + '/', Astro.site).href;
const imageUrl = new URL('/favicon.svg', Astro.site).href;

// Parse minimum ticket price for schema (e.g., "$80 – $1,500" → "80")
const ticketPrice = event.price?.ticket?.min != null ? String(event.price.ticket.min) : '0';

// Event status drives schema fields. ended events use EventCompleted + SoldOut.
const eventStatus = event.status === 'ended'
  ? 'https://schema.org/EventCompleted'
  : 'https://schema.org/EventScheduled';
const offerAvailability = event.status === 'ended'
  ? 'https://schema.org/SoldOut'
  : 'https://schema.org/InStock';

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": event.title,
  "startDate": event.startDate,
  "endDate": event.endDate,
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": eventStatus,
  "location": {
    "@type": "Place",
    "name": event.location?.label || event.venues[0],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": event.hostCities[0],
      "addressCountry": event.location?.country || ""
    }
  },
  "image": [imageUrl],
  "description": event.description,
  "offers": {
    "@type": "Offer",
    "url": refs.ticketUrl || eventUrl,
    "price": ticketPrice,
    "priceCurrency": "USD",
    "availability": offerAvailability
  },
  "organizer": event.organizer ? {
    "@type": "Organization",
    "name": event.organizer.name,
    "url": event.organizer.url
  } : {
    "@type": "Organization",
    "name": "MatchTrip",
    "url": "https://matchtrip-blue.vercel.app"
  }
};

// keywords: only when the event carries searchKeywords (joined as a single string).
// previousEvent/nextEvent are intentionally NOT added: no standard Event property for them.
if (event.searchKeywords?.length) {
  eventSchema.keywords = event.searchKeywords.join(', ');
}

const eventSchemaHtml = `<script type="application/ld+json">${JSON.stringify(eventSchema, null, '\t')}</script>`;

// Article schema: only emitted on pages with travelGuide (editorial content).
// Coexists with Event schema — Google accepts both on the same page.
let articleSchemaHtml = '';
if (event.travelGuide) {
  const articleBodyParts = [];
  if (event.travelGuide.ticketTips?.length) {
    articleBodyParts.push('Tickets Guide: ' + event.travelGuide.ticketTips.map(t => `${t.type} — ${t.detail}`).join(' | '));
  }
  if (event.travelGuide.accommodationAreas?.length) {
    articleBodyParts.push('Where to Stay: ' + event.travelGuide.accommodationAreas.map(a => `${a.name}. ${a.description}`).join(' | '));
  }
  if (event.travelGuide.transportationTips?.length) {
    articleBodyParts.push('Transportation: ' + event.travelGuide.transportationTips.map(t => `${t.mode} — ${t.detail}`).join(' | '));
  }
  const articleSchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": event.title,
    "author": {
      "@type": "Organization",
      "name": "MatchTrip",
      "url": "https://matchtrip-blue.vercel.app"
    },
    "publisher": {
      "@type": "Organization",
      "name": "MatchTrip",
      "url": "https://matchtrip-blue.vercel.app"
    },
    "datePublished": event.startDate,
    "dateModified": event.startDate,
    "articleBody": articleBodyParts.join('\n\n'),
    "url": eventUrl,
    "image": [imageUrl],
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": eventUrl
    }
  };
  articleSchemaHtml = `<script type="application/ld+json">${JSON.stringify(articleSchema, null, '\t')}</script>`;
}

// Travel Overview paragraph (only for events with a travelGuide):
// assembled from existing event fields — description, date, location, budget estimate.
let travelOverviewText = '';
if (event.travelGuide) {
  const overviewSentences = [];
  if (event.description) overviewSentences.push(event.description);
  const overviewLocation = getEventLocation(event);
  if (event.date || overviewLocation) {
    overviewSentences.push(
      `${event.title} takes place${event.date ? ` ${event.date}` : ''}${overviewLocation ? ` in ${overviewLocation}` : ''}.`
    );
  }
  const overviewBudget = getTravelPrice(event);
  if (overviewBudget) {
    overviewSentences.push(`A typical trip including flights, hotels, and tickets is estimated at ${overviewBudget}.`);
  }
  travelOverviewText = overviewSentences.join(' ');
}

// Ticket Guide cards: structured ticket-buying intel from travelGuide.ticketGuide.
// Empty fields are skipped so the grid never renders blank cards.
const ticketGuideCards = [];
if (event.travelGuide?.ticketGuide) {
  const ticketGuide = event.travelGuide.ticketGuide;
  const ticketGuideItems = [
    { title: 'Official Source', detail: ticketGuide.officialSource },
    { title: 'Release Timing', detail: ticketGuide.releaseTiming },
    { title: 'Price Range', detail: ticketGuide.priceRange },
    { title: 'Avoiding Scams', detail: ticketGuide.scamTips },
  ];
  for (const item of ticketGuideItems) {
    if (item.detail) ticketGuideCards.push(item);
  }
}

// Getting There cards: airport / public transport / match-day advice.
const transportGuideCards = [];
if (event.travelGuide?.transportGuide) {
  const transportGuide = event.travelGuide.transportGuide;
  const transportGuideItems = [
    { label: 'Nearest Airport', detail: transportGuide.airport },
    { label: 'Public Transport', detail: transportGuide.publicTransport },
    { label: 'Match Day Tip', detail: transportGuide.matchDayTip },
  ];
  for (const item of transportGuideItems) {
    if (item.detail) transportGuideCards.push(item);
  }
}

// Budget tier cards: travelGuide.budgetTiers strings look like
// "<price> total weekend — <positioning>"; split on the first em-dash.
const splitBudgetTier = value => {
  const sep = value.indexOf('—');
  if (sep === -1) return { price: '', desc: value };
  return { price: value.slice(0, sep).trim(), desc: value.slice(sep + 1).trim() };
};
const budgetTierCards = [];
if (event.travelGuide?.budgetTiers) {
  const budgetTiers = event.travelGuide.budgetTiers;
  const tierDefs = [
    { label: 'Budget', cls: 'tier-budget', value: budgetTiers.budget },
    { label: 'Mid-Range', cls: 'tier-mid', value: budgetTiers.midRange },
    { label: 'Premium', cls: 'tier-premium', value: budgetTiers.premium },
  ];
  for (const tier of tierDefs) {
    if (tier.value) {
      budgetTierCards.push({ label: tier.label, cls: tier.cls, ...splitBudgetTier(tier.value) });
    }
  }
}

// FAQ: data-driven Q&A assembled from existing event fields (rendered for every event).
const faqVenueList = (event.venues || []).join(', ');
const faqHostCityList = (event.hostCities || []).join(', ');
const faqTicketPriceLabel = getTicketPrice(event);
const faqStayAreas = (event.travelGuide?.accommodationAreas || []).slice(0, 2).map(a => a.name);
const faqFirstTransport = event.travelGuide?.transportationTips?.[0];

const faqItems = [
  {
    q: `When is ${event.title}?`,
    a: `${event.title} takes place${event.date ? ` ${event.date}` : ''}${city ? ` in ${city}` : ''}.`,
  },
  {
    q: `Where is ${event.title} held?`,
    a: `${event.title} is held at ${faqVenueList}${faqHostCityList ? ` in host cities including ${faqHostCityList}` : ''}.`,
  },
  {
    q: 'How much do tickets cost?',
    a: faqTicketPriceLabel
      ? `Tickets for ${event.title} typically cost ${faqTicketPriceLabel}.`
      : `Ticket prices for ${event.title} vary by session and seat category.`,
  },
  {
    q: 'Where should I stay?',
    a: faqStayAreas.length
      ? `Recommended places to stay include ${faqStayAreas.join(' and ')}.`
      : `We recommend staying in ${stayCity || city}.`,
  },
  {
    q: 'How do I get there?',
    a: faqFirstTransport
      ? `The recommended way to get there is by ${faqFirstTransport.mode}. ${faqFirstTransport.detail}`
      : `The easiest way to get there is to fly into ${refs.flightTo || city}.`,
  },
];

// Append editorial FAQs from travelGuide.faq (real search-intent Q&A, longer answers).
const editorialFaqs = (event.travelGuide?.faq || []).map(f => ({ q: f.question, a: f.answer }));
for (const f of editorialFaqs) {
  if (!faqItems.some(existing => existing.q.toLowerCase() === f.q.toLowerCase())) {
    faqItems.push(f);
  }
}

// FAQPage structured data: answers use the exact same text as the page.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
const faqSchemaHtml = `<script type="application/ld+json">${JSON.stringify(faqSchema, null, '\t')}</script>`;

// BreadcrumbList structured data: Home > Events > Event.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL('/', Astro.site).href },
    { "@type": "ListItem", "position": 2, "name": "Events", "item": new URL('/events/', Astro.site).href },
    { "@type": "ListItem", "position": 3, "name": event.title, "item": eventUrl },
  ]
};
const breadcrumbSchemaHtml = `<script type="application/ld+json">${JSON.stringify(breadcrumbSchema, null, '\t')}</script>`;

// Sources & Official Information: first-party official links from event data.
// Rows only render when their field is present on the event.
const sourceHostname = url => {
  try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return url; }
};
const sourceRows = [
  {
    label: 'Official website',
    desc: `The official ${event.title} website — schedules, news and event-day information.`,
    url: event.officialWebsite,
  },
  {
    label: 'Official tickets',
    desc: 'The primary official ticket seller — release dates, seat categories and face-value prices.',
    url: event.ticketSource,
  },
  {
    label: 'Venue information',
    desc: 'Official venue details — seating maps, transport options and visitor guidance.',
    url: event.venueSource,
  },
].filter(source => source.url)
  .map(source => ({ ...source, host: sourceHostname(source.url) }));

// ImageObject structured data: category artwork shown in the hero image section.
const imageSchema = {
  "@context": "https://schema.org",
  "@type": "ImageObject",
  "contentUrl": `https://matchtrip-blue.vercel.app/images/og/${heroImageFile}.png`,
  "name": `${event.title} travel guide image`,
  "caption": event.title,
  "license": "https://matchtrip-blue.vercel.app/terms/",
};
const imageSchemaHtml = `<script type="application/ld+json">${JSON.stringify(imageSchema, null, '\t')}</script>`;
---

<Layout
  title={event.title}
  description={event.description}
  category={event.category}
>
  <Navbar />

  <!-- Hero -->
  <section class="event-hero" style={`background: linear-gradient(135deg, ${event.colorFrom} 0%, ${event.colorTo} 100%)`}>
    <div class="container">
      <a href="/events/" class="back-link">&larr; All Events</a>
      <a href={clusterLink.url} class="back-link badge-link">{clusterLink.label}</a>
      <div class="hero-content">
        <span class="event-emoji">{event.emoji}</span>
        <span class="event-category">{event.category}</span>
        <h1>{event.title}</h1>
        <div class="event-meta-bar">
          <span>{event.date}</span>
          <span class="meta-dot">·</span>
          <span>{getEventLocation(event)}</span>
          <span class="meta-dot">·</span>
          <span>Est. Cost: {getTravelPrice(event)}</span>
        </div>
        <p class="event-description">{event.description}</p>
        <!-- Trip Planning CTA -->
        <div class="hero-trip-planning">
          <h3 class="hero-cta-heading">Plan Your Trip</h3>
          <div class="hero-cta-checks">
            <span class="hero-check">&#10003; Hotels near {city}</span>
            <span class="hero-check">&#10003; Flights to {city}</span>
            {activityUrl && <span class="hero-check">&#10003; Things to do in {city}</span>}
          </div>
          <div class="hero-cta-buttons">
            <a href={hotelUrl} class="btn btn-trip" target="_blank" rel="noopener noreferrer sponsored">Find Hotels in {city}</a>
            {activityUrl && <a href={activityUrl} class="btn btn-trip" data-affiliate="viator" data-campaign={campaign} data-destination="viator" target="_blank" rel="noopener noreferrer sponsored">Explore {city} Experiences</a>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Hero category image (per-sport og artwork) -->
  <section class="hero-image-section">
    <div class="container">
      <img class="event-hero-img" src={"/images/og/" + heroImageFile + ".png"} alt={`${event.title} travel guide — tickets, hotels and ${event.location?.city} trip planning`} loading="lazy" width="1200" height="630" />
    </div>
  </section>

  <!-- Next Event (defensive: only ended events that define a next edition) -->
  {event.status === 'ended' && event.nextEvent && (
    <section class="next-event-section">
      <div class="container">
        <div class="next-event-card">
          <div class="next-event-text">
            <p class="next-event-note">This event has finished — plan ahead:</p>
            <h2 class="next-event-title">{event.nextEvent.label}</h2>
          </div>
          <a href={event.nextEvent.slug ? `/events/${event.nextEvent.slug}/` : '/events/'} class="btn btn-primary next-event-btn">Plan Your Next Trip &rarr;</a>
        </div>
      </div>
    </section>
  )}

  <!-- Previous Event (reverse link: upcoming events whose previousEvent slug resolves in eventsData) -->
  {previousEventData && (
    <section class="next-event-section">
      <div class="container">
        <div class="next-event-card previous-event">
          <div class="next-event-text">
            <p class="next-event-note">Previous edition:</p>
            <h2 class="next-event-title">{previousEventData.title}</h2>
          </div>
          <a href={`/events/${event.previousEvent}/`} class="btn btn-primary next-event-btn">View Previous Edition &rarr;</a>
        </div>
      </div>
    </section>
  )}

  <!-- Budget Breakdown -->
  <section class="budget-section">
    <div class="container">
      <h2>Travel Budget Breakdown</h2>
      <p class="section-sub">Estimated cost for a typical sports trip</p>
      <div class="budget-summary">
        <span class="budget-summary-label">Estimated Trip Budget</span>
        <span class="budget-summary-value">{getTravelPrice(event)}</span>
      </div>
      <div class="budget-grid">
        <div class="budget-card">
          <div class="budget-icon" aria-hidden="true">&#x2708;&#xFE0F;</div>
          <h3>Flights</h3>
          <p class="budget-price">{getFlightPrice(event)}</p>
          <p class="budget-note">Round-trip average</p>
          <a href={flightUrl} class="btn btn-outline" target="_blank" rel="noopener noreferrer sponsored">Find Flights</a>
        </div>
        <div class="budget-card">
          <div class="budget-icon" aria-hidden="true">&#x1F3E8;</div>
          <h3>Hotels</h3>
          <p class="budget-price">{getHotelPrice(event)}</p>
          <p class="budget-note">Average per night</p>
          <a href={hotelUrl} class="btn btn-outline" target="_blank" rel="noopener noreferrer sponsored">Find Hotels in {city}</a>
        </div>
        <div class="budget-card highlight">
          <div class="budget-icon" aria-hidden="true">&#x1F3AB;</div>
          <h3>Tickets</h3>
          <p class="budget-price">{getTicketPrice(event)}</p>
          <p class="budget-note">Match/session range</p>
          <a href={officialTicketUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Get Official Tickets</a>
          {resaleTicketLinks.length > 0 && (
            <div class="resale-links">
              <span class="resale-label">Compare Resale:</span>
              {resaleTicketLinks.map(rt => (
                <a href={rt.url} class="resale-link" target="_blank" rel="noopener noreferrer sponsored">{rt.label}</a>
              ))}
            </div>
          )}
        </div>
      </div>
      {event.travelGuide?.budgetBreakdown?.length > 0 && (
        <div class="budget-detail-grid">
          {event.travelGuide.budgetBreakdown.map(item => (
            <div class="budget-detail-card">
              <h3>{item.category}</h3>
              <p>{item.detail}</p>
            </div>
          ))}
        </div>
      )}
      {budgetTierCards.length > 0 && (
        <div class="trip-cost">
          <h2>What Does This Trip Cost?</h2>
          <p class="section-sub">Typical total spend per person, three ways to do this trip</p>
          <div class="tier-grid">
            {budgetTierCards.map(tier => (
              <div class={`tier-card ${tier.cls}`}>
                <span class="tier-label">{tier.label}</span>
                {tier.price && <p class="tier-price">{tier.price}</p>}
                {tier.desc && <p class="tier-desc">{tier.desc}</p>}
              </div>
            ))}
          </div>
        </div>
      )}
      <AffiliateDisclosure />
    </div>
  </section>

  <!-- Ticket Guide (conditional: only for events with travelGuide.ticketGuide data) -->
  {ticketGuideCards.length > 0 && (
    <section class="ticket-guide-section">
      <div class="container">
        <h2>Ticket Guide</h2>
        <p class="section-sub">Where to buy, when sales open, what you'll pay, and how to avoid scams</p>
        <div class="ticket-guide-grid">
          {ticketGuideCards.map(card => (
            <div class="ticket-guide-card">
              <h3>{card.title}</h3>
              <p>{card.detail}</p>
            </div>
          ))}
        </div>
      </div>
