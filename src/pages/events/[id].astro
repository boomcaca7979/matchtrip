            </div>
          </div>
        </section>
      )}
    </>
  )}

  <!-- 3-Day Trip Itinerary (conditional: only for events with itinerary data) -->
  {event.travelGuide?.itinerary && event.travelGuide.itinerary.length > 0 && (
